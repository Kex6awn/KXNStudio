@{
    ViewData["Title"] = "Booking Calendar";
}

<div class="d-flex gap-3 mb-3">

    <span class="badge bg-success">
        Confirmed
    </span>

    <span class="badge bg-warning text-dark">
        Pending
    </span>

    <span class="badge bg-danger">
        Declined
    </span>

    <span class="badge bg-secondary">
        Cancelled
    </span>

</div>

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">Booking Calendar</h1>
            <p class="text-muted mb-0">
                View pending and confirmed photography sessions.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Bookings"
           asp-action="Index"
           class="btn btn-secondary">
            <i class="bi bi-list-ul me-1"></i>
            List View
        </a>
    </div>

    <div class="card shadow-sm border-0 calendar-card mx-auto">
        <div class="card-body p-4">
            <div id="bookingCalendar"></div>
        </div>
    </div>

</div>

@section Styles {
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.css" />

    <style>
        .calendar-card {
            border-radius: 16px;
            max-width: 1200px;
        }

        #bookingCalendar {
            min-height: 560px;
        }

        .fc .fc-toolbar-title {
            font-size: 1.35rem;
            font-weight: 700;
        }

        .fc .fc-button {
            border-radius: 8px;
        }

        .fc-event {
            cursor: pointer;
            border-radius: 8px;
            font-size: 0.85rem;
            border: none;
            padding: 2px 4px;
        }

            .fc-event:hover {
                transform: scale(1.02);
                transition: .15s ease;
            }

        .fc-toolbar {
            margin-bottom: 1.5rem !important;
        }

            .fc-event.confirmed-event,
            .fc-event.confirmed-event .fc-event-title,
            .fc-event.confirmed-event .fc-event-time {
                color: #ffffff !important;
            }

            .fc-event.pending-event,
            .fc-event.pending-event .fc-event-title,
            .fc-event.pending-event .fc-event-time {
                color: #212529 !important;
            }

        .fc .fc-day-today {
            background-color: transparent !important;
        }
    </style>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const calendarElement =
                document.getElementById("bookingCalendar");

            const calendar = new FullCalendar.Calendar(
                calendarElement,
                {
                    initialView: "dayGridMonth",
                    height: "auto",

                    headerToolbar: {
                        left: "prev,next today",
                        center: "title",
                        right: "dayGridMonth,timeGridWeek,timeGridDay"
                    },

                    events: {
                        url: "@Url.Action("GetCalendarEvents", "Bookings", new { area = "Admin" })",

                        failure: function () {
                            alert("Bookings could not be loaded.");
                        }
                    },

                    eventDidMount: function (info) {
                        const status = info.event.extendedProps.status;

                        if (status === "Confirmed") {
                            info.el.classList.add("confirmed-event");
                            info.el.style.backgroundColor = "#198754";
                            info.el.style.borderColor = "#198754";
                        }
                        else if (status === "Pending") {
                            info.el.classList.add("pending-event");
                            info.el.style.backgroundColor = "#ffc107";
                            info.el.style.borderColor = "#ffc107";
                            info.el.style.color = "#212529";
                        }
                    },

                    eventClick: function (info) {
                        if (info.event.url) {
                            info.jsEvent.preventDefault();
                            window.location.href = info.event.url;
                        }
                    }
                });

            calendar.render();
        });
    </script>
}