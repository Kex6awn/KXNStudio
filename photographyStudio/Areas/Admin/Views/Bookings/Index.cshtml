@model List<KxnPhotoStudio.Models.Booking>

@{
    ViewData["Title"] = "Bookings";

    var totalBookings = Model.Count;

    var pendingBookings = Model.Count(b =>
        string.Equals(
            b.Status,
            "Pending",
            StringComparison.OrdinalIgnoreCase));

    var confirmedBookings = Model.Count(b =>
        string.Equals(
            b.Status,
            "Confirmed",
            StringComparison.OrdinalIgnoreCase));

    var declinedBookings = Model.Count(b =>
        string.Equals(
            b.Status,
            "Declined",
            StringComparison.OrdinalIgnoreCase));

    var cancelledBookings = Model.Count(b =>
        string.Equals(
            b.Status,
            "Cancelled",
            StringComparison.OrdinalIgnoreCase));
}

<div class="container-fluid kxn-page">

    <div class="kxn-page-header">

        <div>
            <h1 class="kxn-page-title">
                Bookings
            </h1>

            <p class="kxn-page-description">
                Review booking requests, session details, and booking status.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Bookings"
           asp-action="Calendar"
           class="btn kxn-btn-outline">

            <i class="bi bi-calendar3 me-1"></i>
            Booking Calendar

        </a>

    </div>

    @if (!string.IsNullOrWhiteSpace(ViewBag.StatusFilter as string))
    {
        <div class="alert alert-info d-flex justify-content-between align-items-center mb-4">

            <div>
                Showing bookings with status:
                <strong>@ViewBag.StatusFilter</strong>
            </div>

            <button type="button"
                    class="btn btn-sm kxn-btn-outline"
                    onclick="window.location.replace('@Url.Action("Index", "Bookings", new { area = "Admin" })')">
                Clear Filter
            </button>

        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["WarningMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show">

            @TempData["WarningMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    <!-- Summary Cards -->

    <div class="row g-4 mb-4">

        <div class="col-md-6 col-xl">

            <partial name="_StatCard"
                     model='new KxnPhotoStudio.Models.ViewModels.StatCardViewModel
             {
                 Label = "Total Bookings",
                 Value = totalBookings.ToString(),
                 IconClass = "bi bi-calendar-check"
             }' />

        </div>

        <div class="col-md-6 col-xl">

            <partial name="_StatCard"
                     model='new KxnPhotoStudio.Models.ViewModels.StatCardViewModel
             {
                 Label = "Pending",
                 Value = pendingBookings.ToString(),
                 IconClass = "bi bi-hourglass-split"
             }' />

        </div>

        <div class="col-md-6 col-xl">

            <partial name="_StatCard"
                     model='new KxnPhotoStudio.Models.ViewModels.StatCardViewModel
             {
                 Label = "Confirmed",
                 Value = confirmedBookings.ToString(),
                 ValueClass = "text-success",
                 IconClass = "bi bi-check-circle"
             }' />

        </div>

        <div class="col-md-6 col-xl">

            <partial name="_StatCard"
                     model='new KxnPhotoStudio.Models.ViewModels.StatCardViewModel
             {
                 Label = "Declined",
                 Value = declinedBookings.ToString(),
                 ValueClass = "text-danger",
                 IconClass = "bi bi-x-circle"
             }' />

        </div>

        <div class="col-md-6 col-xl">

            <partial name="_StatCard"
                     model='new KxnPhotoStudio.Models.ViewModels.StatCardViewModel
             {
                 Label = "Cancelled",
                 Value = cancelledBookings.ToString(),
                 ValueClass = "text-secondary",
                 IconClass = "bi bi-slash-circle"
             }' />

        </div>

    </div>

    @if (!Model.Any())
    {
        <div class="kxn-card">

            <div class="kxn-empty-state">

                <div class="kxn-empty-icon">
                    <i class="bi bi-calendar-x"></i>
                </div>

                @if (!string.IsNullOrWhiteSpace(ViewBag.StatusFilter as string))
                {
                    <h4 class="kxn-empty-title">
                        No matching bookings
                    </h4>

                    <p class="kxn-empty-description">
                        There are no bookings with the
                        <strong>@ViewBag.StatusFilter</strong>
                        status.
                    </p>

                    <button type="button"
                            class="btn btn-sm kxn-btn-outline"
                            onclick="window.location.replace('@Url.Action("Index", "Bookings", new { area = "Admin" })')">
                        Clear Filter
                    </button>
                }
                else
                {
                    <h4 class="kxn-empty-title">
                        No bookings yet
                    </h4>

                    <p class="kxn-empty-description">
                        New booking requests will appear here when clients submit them.
                    </p>
                }

            </div>

        </div>
    }
    else
    {
        <div class="kxn-table-wrapper">

            <div class="table-responsive">

                <table class="table kxn-table">

                    <thead>
                        <tr>
                            <th>Client</th>
                            <th>Service</th>
                            <th>Session Date</th>
                            <th>Time</th>
                            <th>Duration</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var booking in Model)
                        {
                            var formattedTime = DateTime.Today
                            .Add(booking.StartTime)
                            .ToString("h:mm tt");

                            <tr>

                                <td>

                                    <div class="fw-semibold">
                                        @booking.FullName
                                    </div>

                                    <small class="text-muted">
                                        @booking.Email
                                    </small>

                                </td>

                                <td>
                                    @booking.ServiceType
                                </td>

                                <td>
                                    @booking.EventDate.ToString("MMM dd, yyyy")
                                </td>

                                <td>
                                    @formattedTime
                                </td>

                                <td>
                                    @booking.DurationHours hour(s)
                                </td>

                                <td>
                                    <partial name="_StatusBadge" model="booking.Status" />
                                </td>

                                <td class="text-end">

                                    <div class="d-inline-flex gap-2">

                                        <a asp-area="Admin"
                                           asp-controller="Bookings"
                                           asp-action="Details"
                                           asp-route-id="@booking.BookingId"
                                           class="btn btn-sm kxn-btn-outline">

                                            <i class="bi bi-eye me-1"></i>
                                            View

                                        </a>

                                        <a asp-area="Admin"
                                           asp-controller="Bookings"
                                           asp-action="Edit"
                                           asp-route-id="@booking.BookingId"
                                           class="btn btn-sm btn-primary">

                                            <i class="bi bi-pencil me-1"></i>
                                            Edit

                                        </a>

                                        <a asp-area="Admin"
                                           asp-controller="Bookings"
                                           asp-action="Delete"
                                           asp-route-id="@booking.BookingId"
                                           class="btn btn-sm btn-outline-danger">

                                            <i class="bi bi-trash me-1"></i>
                                            Delete

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }

</div>