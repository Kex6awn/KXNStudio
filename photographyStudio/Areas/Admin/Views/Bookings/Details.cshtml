@model KxnPhotoStudio.Models.Booking

@{
    ViewData["Title"] = "Booking Details";
}

<h2>Booking Details</h2>

<div class="mb-3"><strong>Name: </strong>@Model.FullName</div>
<div class="mb-3"><strong>Email: </strong>@Model.Email</div>
<div class="mb-3"><strong>Phone: </strong>@Model.PhoneNumber</div>
<div class="mb-3"><strong>Service: </strong>@Model.ServiceType</div>
<div class="mb-3"><strong>Date: </strong>@Model.EventDate.ToShortDateString()</div>
<div class="mb-3"><strong>Start Time: </strong>@Model.StartTime.ToString(@"hh\:mm")</div>
<div class="mb-3"><strong>Duration: </strong>@Model.DurationHours hour(s)</div>
<div class="mb-3"><strong>Message: </strong>@Model.Message</div>
<div class="mb-3"><strong>Status: </strong>@Model.Status</div>

@if (string.Equals(Model.Status, "Confirmed", StringComparison.OrdinalIgnoreCase)
   && Model.Invoice == null)
{
    <a asp-area="Admin"
       asp-controller="Invoices"
       asp-action="Create"
       asp-route-bookingId="@Model.BookingId"
       class="btn btn-success">
        <i class="bi bi-receipt me-1"></i>
        Create Invoice
    </a>
}

<a asp-area="Admin"
   asp-controller="Bookings"
   asp-action="Index"
   class="btn btn-secondary">
    Back
</a>

