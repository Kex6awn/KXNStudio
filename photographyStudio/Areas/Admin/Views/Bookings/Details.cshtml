@model KxnPhotoStudio.Models.Booking

@{
    ViewData["Title"] = "Booking Details";
}

<h2>Booking Details</h2>

<div class="mb-3"><strong>Name:</strong>@Model.FullName</div>
<div class="mb-3"><strong>Email:</strong>@Model.Email</div>
<div class="mb-3"><strong>Phone:</strong>@Model.PhoneNumber</div>
<div class="mb-3"><strong>Service:</strong>@Model.ServiceType</div>
<div class="mb-3"><strong>Date:</strong>@Model.EventDate.ToShortDateString()</div>
<div class="mb-3"><strong>Message:</strong>@Model.Message</div>
<div class="mb-3"><strong>Status:</strong>@Model.Status</div>

<a asp-action="Index" class="btn btn-secondary">Back</a>

