@model KxnPhotoStudio.Models.ViewModels.BookingDetailsViewModel
@using KxnPhotoStudio.Models
@using KxnPhotoStudio.Models.ViewModels

@{
    ViewData["Title"] = "Booking Details";

    var booking = Model.Booking;
    var job = Model.JobCompletion;

    var formattedTime = DateTime.Today
        .Add(booking.StartTime)
        .ToString("h:mm tt");

    var pageHeader = new PageHeaderViewModel
            {
                Title = "Booking Details",
                Description = $"Review the booking for {booking.FullName}."
            };
}

<div class="container-fluid kxn-page">

    <partial name="_PageHeader"
             model="pageHeader" />


    <!-- Actions -->
    <div class="d-flex flex-wrap justify-content-end gap-2 mb-4">

        <a asp-area="Admin"
           asp-controller="Bookings"
           asp-action="Index"
           class="btn kxn-btn-outline">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Bookings

        </a>

        <a asp-area="Admin"
           asp-controller="Bookings"
           asp-action="Edit"
           asp-route-id="@booking.BookingId"
           class="btn btn-primary">

            <i class="bi bi-pencil me-1"></i>
            Edit Booking

        </a>


        @if (string.Equals(
        booking.Status,
        BookingStatuses.Confirmed,
        StringComparison.OrdinalIgnoreCase)
        && booking.Invoice == null)
        {
            <a asp-area="Admin"
               asp-controller="Invoices"
               asp-action="Create"
               asp-route-bookingId="@booking.BookingId"
               class="btn btn-success">

                <i class="bi bi-receipt me-1"></i>
                Create Invoice

            </a>
        }


        @if (booking.Invoice != null)
        {
            <a asp-area="Admin"
               asp-controller="Invoices"
               asp-action="Details"
               asp-route-id="@booking.Invoice.InvoiceId"
               class="btn btn-success">

                <i class="bi bi-receipt me-1"></i>
                View Invoice

            </a>
        }


        @if (string.Equals(
        booking.Status,
        BookingStatuses.Completed,
        StringComparison.OrdinalIgnoreCase)
        && booking.SessionWorkflow != null)
        {
            <a asp-area="Admin"
               asp-controller="Bookings"
               asp-action="EditWorkflow"
               asp-route-bookingId="@booking.BookingId"
               class="btn btn-dark">

                <i class="bi bi-images me-1"></i>
                Update Workflow

            </a>
        }

    </div>


    <div class="row g-4">

        <!-- LEFT COLUMN -->
        <div class="col-lg-8">

            <!-- Session Information -->
            <div class="kxn-card">

                <div class="kxn-card-header">

                    <div class="d-flex justify-content-between align-items-start gap-3">

                        <div>

                            <h3 class="kxn-card-title">
                                Session Information
                            </h3>

                            <p class="kxn-card-description">
                                Booking and photography session details.
                            </p>

                        </div>

                        <partial name="_StatusBadge"
                                 model="booking.Status" />

                    </div>

                </div>


                <div class="kxn-card-body">

                    <div class="row g-4">

                        <div class="col-md-6">

                            <p class="text-muted mb-1">
                                Client
                            </p>

                            <p class="fw-semibold mb-4">
                                @booking.FullName
                            </p>


                            <p class="text-muted mb-1">
                                Email
                            </p>

                            <p class="mb-4">

                                <a href="mailto:@booking.Email"
                                   class="text-decoration-none">
                                    @booking.Email
                                </a>

                            </p>


                            <p class="text-muted mb-1">
                                Phone
                            </p>

                            <p class="mb-0">

                                @if (!string.IsNullOrWhiteSpace(booking.PhoneNumber))
                                {
                                    <a href="tel:@booking.PhoneNumber"
                                       class="text-decoration-none">
                                        @booking.PhoneNumber
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Not provided
                                    </span>
                                }

                            </p>

                        </div>


                        <div class="col-md-6">

                            <p class="text-muted mb-1">
                                Service
                            </p>

                            <p class="fw-semibold mb-4">
                                @booking.ServiceType
                            </p>


                            <p class="text-muted mb-1">
                                Session Date
                            </p>

                            <p class="mb-4">
                                @booking.EventDate.ToString("MMMM dd, yyyy")
                            </p>


                            <p class="text-muted mb-1">
                                Time
                            </p>

                            <p class="mb-4">
                                @formattedTime
                            </p>


                            <p class="text-muted mb-1">
                                Duration
                            </p>

                            <p class="mb-0">
                                @booking.DurationHours hour(s)
                            </p>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Client Message -->
            <div class="kxn-card mt-4">

                <div class="kxn-card-header">

                    <h3 class="kxn-card-title">
                        Client Message
                    </h3>

                    <p class="kxn-card-description">
                        Additional information submitted with the booking.
                    </p>

                </div>


                <div class="kxn-card-body">

                    @if (!string.IsNullOrWhiteSpace(booking.Message))
                    {
                        <p class="mb-0"
                           style="white-space:pre-line;">@booking.Message</p>
                    }
                    else
                    {
                        <span class="text-muted">
                            No additional message was provided.
                        </span>
                    }

                </div>

            </div>

        </div>


        <!-- RIGHT COLUMN -->
        <div class="col-lg-4">

            <!-- Booking Summary -->
            <div class="kxn-card">

                <div class="kxn-card-header">

                    <h3 class="kxn-card-title">
                        Booking Summary
                    </h3>

                    <p class="kxn-card-description">
                        Current booking status and related records.
                    </p>

                </div>


                <div class="kxn-card-body">

                    <div class="d-flex justify-content-between align-items-center mb-3">

                        <span class="text-muted">
                            Status
                        </span>

                        <partial name="_StatusBadge"
                                 model="booking.Status" />

                    </div>

                    <hr />


                    <div class="d-flex justify-content-between mb-3">

                        <span class="text-muted">
                            Invoice
                        </span>

                        @if (booking.Invoice != null)
                        {
                            <a asp-area="Admin"
                               asp-controller="Invoices"
                               asp-action="Details"
                               asp-route-id="@booking.Invoice.InvoiceId"
                               class="fw-semibold text-decoration-none">

                                @booking.Invoice.InvoiceNumber

                            </a>
                        }
                        else
                        {
                            <span class="text-muted">
                                Not created
                            </span>
                        }

                    </div>


                    <div class="d-flex justify-content-between">

                        <span class="text-muted">
                            Created
                        </span>

                        <span>
                            @(booking.CreatedAt
                                .ToLocalTime()
                                .ToString("MMM dd, yyyy"))
                        </span>

                    </div>

                </div>

            </div>


            <!-- Job Completion -->
            <div class="kxn-card mt-4">

                <div class="kxn-card-header">

                    <div class="d-flex justify-content-between align-items-start gap-3">

                        <div>

                            <h3 class="kxn-card-title">
                                Job Completion
                            </h3>

                            <p class="kxn-card-description">
                                Overall completion of this photography job.
                            </p>

                        </div>

                        @if (job.IsJobComplete)
                        {
                            <span class="kxn-status kxn-status-paid">
                                Complete
                            </span>
                        }
                        else
                        {
                            <span class="kxn-status kxn-status-partial">
                                In Progress
                            </span>
                        }

                    </div>

                </div>


                <div class="kxn-card-body">

                    <!-- Session -->
                    <div class="d-flex justify-content-between align-items-center mb-3">

                        <div class="d-flex align-items-center gap-2">

                            @if (job.SessionCompleted)
                            {
                                <i class="bi bi-check-circle-fill text-success"></i>
                            }
                            else
                            {
                                <i class="bi bi-circle text-secondary"></i>
                            }

                            <span>
                                Session Completed
                            </span>

                        </div>

                        @if (job.SessionCompleted)
                        {
                            <span class="text-success fw-semibold">
                                Complete
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">
                                Pending
                            </span>
                        }

                    </div>


                    <!-- Payment -->
                    <div class="d-flex justify-content-between align-items-center mb-3">

                        <div class="d-flex align-items-center gap-2">

                            @if (job.InvoicePaid)
                            {
                                <i class="bi bi-check-circle-fill text-success"></i>
                            }
                            else
                            {
                                <i class="bi bi-circle text-secondary"></i>
                            }

                            <span>
                                Invoice Paid
                            </span>

                        </div>

                        @if (job.InvoicePaid)
                        {
                            <span class="text-success fw-semibold">
                                Paid
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">
                                Outstanding
                            </span>
                        }

                    </div>


                    <!-- Delivery -->
                    <div class="d-flex justify-content-between align-items-center">

                        <div class="d-flex align-items-center gap-2">

                            @if (job.GalleryDelivered)
                            {
                                <i class="bi bi-check-circle-fill text-success"></i>
                            }
                            else
                            {
                                <i class="bi bi-circle text-secondary"></i>
                            }

                            <span>
                                Gallery Delivered
                            </span>

                        </div>

                        @if (job.GalleryDelivered)
                        {
                            <span class="text-success fw-semibold">
                                Delivered
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">
                                Pending
                            </span>
                        }

                    </div>


                    @if (job.IsJobComplete)
                    {
                        <div class="alert alert-success mt-4 mb-0">

                            <div class="d-flex gap-2">

                                <i class="bi bi-check-circle-fill"></i>

                                <div>

                                    <strong>
                                        Job complete
                                    </strong>

                                    <div class="small">
                                        The session, payment, and gallery delivery are all complete.
                                    </div>

                                </div>

                            </div>

                        </div>
                    }

                </div>

            </div>


            <!-- Post-Session Workflow -->
            @if (string.Equals(
            booking.Status,
            BookingStatuses.Completed,
            StringComparison.OrdinalIgnoreCase))
            {
                <div class="kxn-card mt-4">

                    <div class="kxn-card-header">

                        <div class="d-flex justify-content-between align-items-start gap-3">

                            <div>

                                <h3 class="kxn-card-title">
                                    Post-Session Workflow
                                </h3>

                                <p class="kxn-card-description">
                                    Track editing and gallery delivery.
                                </p>

                            </div>

                            <a asp-area="Admin"
                               asp-controller="Bookings"
                               asp-action="EditWorkflow"
                               asp-route-bookingId="@booking.BookingId"
                               class="btn btn-sm kxn-btn-outline">

                                <i class="bi bi-pencil me-1"></i>
                                Update

                            </a>

                        </div>

                    </div>


                    <div class="kxn-card-body">

                        @if (booking.SessionWorkflow != null)
                        {
                            var editingClass =
                            booking.SessionWorkflow.EditingStatus switch
                            {
                                "Completed" => "kxn-status-paid",
                                "In Progress" => "kxn-status-partial",
                                _ => "kxn-status-pending"
                            };

                            var deliveryClass =
                            booking.SessionWorkflow.DeliveryStatus switch
                            {
                                "Delivered" => "kxn-status-paid",
                                "Ready" => "kxn-status-partial",
                                _ => "kxn-status-pending"
                            };


                            <!-- Editing -->
                            <div class="d-flex justify-content-between align-items-center mb-3">

                                <span class="text-muted">
                                    Editing
                                </span>

                                <span class="kxn-status @editingClass">
                                    @booking.SessionWorkflow.EditingStatus
                                </span>

                            </div>

                            <hr />


                            <!-- Delivery -->
                            <div class="d-flex justify-content-between align-items-center mb-3">

                                <span class="text-muted">
                                    Delivery
                                </span>

                                <span class="kxn-status @deliveryClass">
                                    @booking.SessionWorkflow.DeliveryStatus
                                </span>

                            </div>


                            @if (booking.SessionWorkflow.EditingStartedAt.HasValue)
                            {
                                <div class="d-flex justify-content-between mb-3">

                                    <span class="text-muted">
                                        Editing Started
                                    </span>

                                    <span>
                                        @(booking.SessionWorkflow.EditingStartedAt.Value
                                            .ToLocalTime()
                                            .ToString("MMM dd, yyyy"))
                                    </span>

                                </div>
                            }


                            @if (booking.SessionWorkflow.EditingCompletedAt.HasValue)
                            {
                                <div class="d-flex justify-content-between mb-3">

                                    <span class="text-muted">
                                        Editing Completed
                                    </span>

                                    <span>
                                        @(booking.SessionWorkflow.EditingCompletedAt.Value
                                            .ToLocalTime()
                                            .ToString("MMM dd, yyyy"))
                                    </span>

                                </div>
                            }


                            @if (booking.SessionWorkflow.DeliveredAt.HasValue)
                            {
                                <div class="d-flex justify-content-between mb-3">

                                    <span class="text-muted">
                                        Delivered
                                    </span>

                                    <span>
                                        @(booking.SessionWorkflow.DeliveredAt.Value
                                            .ToLocalTime()
                                            .ToString("MMM dd, yyyy"))
                                    </span>

                                </div>
                            }

                            <hr />


                            <!-- Gallery -->
                            <div class="mb-3">

                                <p class="text-muted mb-1">
                                    Gallery
                                </p>

                                @if (!string.IsNullOrWhiteSpace(
                               booking.SessionWorkflow.GalleryUrl))
                                {
                                    <a href="@booking.SessionWorkflow.GalleryUrl"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="fw-semibold text-decoration-none">

                                        <i class="bi bi-box-arrow-up-right me-1"></i>
                                        Open Client Gallery

                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Not added yet
                                    </span>
                                }

                            </div>


                            @if (!string.IsNullOrWhiteSpace(
                           booking.SessionWorkflow.DeliveryNotes))
                            {
                                <div>

                                    <p class="text-muted mb-1">
                                        Delivery Notes
                                    </p>

                                    <p class="mb-0"
                                       style="white-space:pre-line;">@booking.SessionWorkflow.DeliveryNotes</p>

                                </div>
                            }
                        }
                        else
                        {
                            <div class="kxn-empty-state py-4">

                                <div class="kxn-empty-icon">
                                    <i class="bi bi-images"></i>
                                </div>

                                <h5 class="kxn-empty-title">
                                    Workflow not started
                                </h5>

                                <p class="kxn-empty-description">
                                    Start tracking editing and gallery delivery for this session.
                                </p>

                            </div>
                        }

                    </div>

                </div>
            }

        </div>

    </div>

</div>