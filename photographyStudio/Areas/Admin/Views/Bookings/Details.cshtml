@model KxnPhotoStudio.Models.Booking
@using KxnPhotoStudio.Models
@using KxnPhotoStudio.Models.ViewModels

@{
    ViewData["Title"] = "Booking Details";

    var formattedTime = DateTime.Today
        .Add(Model.StartTime)
        .ToString("h:mm tt");

    var pageHeader = new PageHeaderViewModel
            {
                Title = "Booking Details",
                Description = $"Review the booking for {Model.FullName}."
            };
}

<div class="container-fluid kxn-page">

    <partial name="_PageHeader"
             model="pageHeader" />

    <div class="d-flex flex-wrap justify-content-end gap-2 mb-4">

        <a asp-area="Admin"
           asp-controller="Bookings"
           asp-action="Index"
           class="btn kxn-btn-outline">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Bookings
        </a>

        <a asp-area="Admin"
           asp-controller="Bookings"
           asp-action="Edit"
           asp-route-id="@Model.BookingId"
           class="btn btn-primary">
            <i class="bi bi-pencil me-1"></i>
            Edit Booking
        </a>

        @if (string.Equals(
               Model.Status,
               "Confirmed",
               StringComparison.OrdinalIgnoreCase)
           && Model.Invoice == null)
        {
                <a asp-area="Admin"
                   asp-controller="Invoices"
                   asp-action="Create"
                   asp-route-bookingId="@Model.BookingId"
                   class="btn btn-success">
                    <i class="bi bi-receipt me-1"></i>
                    Create Invoice
                </a>
        }

        @if (Model.Invoice != null)
        {
                <a asp-area="Admin"
                   asp-controller="Invoices"
                   asp-action="Details"
                   asp-route-id="@Model.Invoice.InvoiceId"
                   class="btn btn-success">
                    <i class="bi bi-receipt me-1"></i>
                    View Invoice
                </a>
        }

        @if (string.Equals(
                Model.Status,
                BookingStatuses.Completed,
                StringComparison.OrdinalIgnoreCase)
                && Model.SessionWorkflow != null)
        {
            <a asp-area="Admin"
               asp-controller="Bookings"
               asp-action="EditWorkflow"
               asp-route-bookingId="@Model.BookingId"
               class="btn btn-dark">

                <i class="bi bi-images me-1"></i>
                Update Workflow

            </a>
        }

    </div>

    <div class="row g-4">

        <div class="col-lg-8">

            <div class="kxn-card">

                <div class="kxn-card-header">

                    <div class="d-flex justify-content-between align-items-start gap-3">

                        <div>
                            <h3 class="kxn-card-title">
                                Session Information
                            </h3>

                            <p class="kxn-card-description">
                                Booking and photography session details.
                            </p>
                        </div>

                        <partial name="_StatusBadge"
                                 model="Model.Status" />

                    </div>

                </div>

                <div class="kxn-card-body">

                    <div class="row g-4">

                        <div class="col-md-6">

                            <p class="text-muted mb-1">
                                Client
                            </p>

                            <p class="fw-semibold mb-4">
                                @Model.FullName
                            </p>

                            <p class="text-muted mb-1">
                                Email
                            </p>

                            <p class="mb-4">
                                <a href="mailto:@Model.Email"
                                   class="text-decoration-none">
                                    @Model.Email
                                </a>
                            </p>

                            <p class="text-muted mb-1">
                                Phone
                            </p>

                            <p class="mb-0">
                                @if (!string.IsNullOrWhiteSpace(Model.PhoneNumber))
                                {
                                        <a href="tel:@Model.PhoneNumber"
                                           class="text-decoration-none">
                                        @Model.PhoneNumber
                                        </a>
                                }
                                else
                                {
                                        <span class="text-muted">
                                            Not provided
                                        </span>
                                }
                            </p>

                        </div>

                        <div class="col-md-6">

                            <p class="text-muted mb-1">
                                Service
                            </p>

                            <p class="fw-semibold mb-4">
                                @Model.ServiceType
                            </p>

                            <p class="text-muted mb-1">
                                Session Date
                            </p>

                            <p class="mb-4">
                                @Model.EventDate.ToString("MMMM dd, yyyy")
                            </p>

                            <p class="text-muted mb-1">
                                Time
                            </p>

                            <p class="mb-4">
                                @formattedTime
                            </p>

                            <p class="text-muted mb-1">
                                Duration
                            </p>

                            <p class="mb-0">
                                @Model.DurationHours hour(s)
                            </p>

                        </div>

                    </div>

                </div>

            </div>

            <div class="kxn-card mt-4">

                <div class="kxn-card-header">

                    <h3 class="kxn-card-title">
                        Client Message
                    </h3>

                    <p class="kxn-card-description">
                        Additional information submitted with the booking.
                    </p>

                </div>

                <div class="kxn-card-body">

                    @if (!string.IsNullOrWhiteSpace(Model.Message))
                    {
                            <p class="mb-0"
                               style="white-space:pre-wrap;">
                            @Model.Message
                            </p>
                    }
                    else
                    {
                            <span class="text-muted">
                                No additional message was provided.
                            </span>
                    }

                </div>

            </div>

        </div>

        <div class="col-lg-4">

            <div class="kxn-card">

                <div class="kxn-card-header">

                    <h3 class="kxn-card-title">
                        Booking Summary
                    </h3>

                    <p class="kxn-card-description">
                        Current booking status and related records.
                    </p>

                </div>

                <div class="kxn-card-body">

                    <div class="d-flex justify-content-between align-items-center mb-3">

                        <span class="text-muted">
                            Status
                        </span>

                        <partial name="_StatusBadge"
                                 model="Model.Status" />

                    </div>

                    <hr />

                    <div class="d-flex justify-content-between mb-3">

                        <span class="text-muted">
                            Invoice
                        </span>

                        @if (Model.Invoice != null)
                        {
                            <a asp-area="Admin"
                               asp-controller="Invoices"
                               asp-action="Details"
                               asp-route-id="@Model.Invoice.InvoiceId"
                               class="fw-semibold text-decoration-none">

                                @Model.Invoice.InvoiceNumber

                            </a>
                        }
                        else
                        {
                            <span class="text-muted">
                                Not created
                            </span>
                        }

                    </div>

                    <div class="d-flex justify-content-between">

                        <span class="text-muted">
                            Created
                        </span>

                        <span>
                            @(Model.CreatedAt
                                .ToLocalTime()
                                .ToString("MMM dd, yyyy"))
                        </span>

                    </div>

                </div>

            </div>


            @if (string.Equals(
            Model.Status,
            BookingStatuses.Completed,
            StringComparison.OrdinalIgnoreCase))
            {
                <div class="kxn-card mt-4">

                    <div class="kxn-card-header">

                        <div class="d-flex justify-content-between align-items-start gap-3">

                            <div>
                                <h3 class="kxn-card-title">
                                    Post-Session Workflow
                                </h3>

                                <p class="kxn-card-description">
                                    Track editing and gallery delivery.
                                </p>
                            </div>

                            <a asp-area="Admin"
                               asp-controller="Bookings"
                               asp-action="EditWorkflow"
                               asp-route-bookingId="@Model.BookingId"
                               class="btn btn-sm kxn-btn-outline">

                                <i class="bi bi-pencil me-1"></i>
                                Update

                            </a>

                        </div>

                    </div>

                    <div class="kxn-card-body">

                        @if (Model.SessionWorkflow != null)
                        {
                            var editingClass =
                            Model.SessionWorkflow.EditingStatus switch
                            {
                                "Completed" => "kxn-status-paid",
                                "In Progress" => "kxn-status-partial",
                                _ => "kxn-status-pending"
                            };

                            var deliveryClass =
                            Model.SessionWorkflow.DeliveryStatus switch
                            {
                                "Delivered" => "kxn-status-paid",
                                "Ready" => "kxn-status-partial",
                                _ => "kxn-status-pending"
                            };

                            <div class="d-flex justify-content-between align-items-center mb-3">

                                <span class="text-muted">
                                    Editing
                                </span>

                                <span class="kxn-status @editingClass">
                                    @Model.SessionWorkflow.EditingStatus
                                </span>

                            </div>

                            <hr />

                            <div class="d-flex justify-content-between align-items-center mb-3">

                                <span class="text-muted">
                                    Delivery
                                </span>

                                <span class="kxn-status @deliveryClass">
                                    @Model.SessionWorkflow.DeliveryStatus
                                </span>

                            </div>

                            @if (Model.SessionWorkflow.EditingStartedAt.HasValue)
                            {
                                <div class="d-flex justify-content-between mb-3">

                                    <span class="text-muted">
                                        Editing Started
                                    </span>

                                    <span>
                                        @(Model.SessionWorkflow.EditingStartedAt.Value
                                            .ToLocalTime()
                                            .ToString("MMM dd, yyyy"))
                                    </span>

                                </div>
                            }

                            @if (Model.SessionWorkflow.EditingCompletedAt.HasValue)
                            {
                                <div class="d-flex justify-content-between mb-3">

                                    <span class="text-muted">
                                        Editing Completed
                                    </span>

                                    <span>
                                        @(Model.SessionWorkflow.EditingCompletedAt.Value
                                            .ToLocalTime()
                                            .ToString("MMM dd, yyyy"))
                                    </span>

                                </div>
                            }

                            @if (Model.SessionWorkflow.DeliveredAt.HasValue)
                            {
                                <div class="d-flex justify-content-between mb-3">

                                    <span class="text-muted">
                                        Delivered
                                    </span>

                                    <span>
                                        @(Model.SessionWorkflow.DeliveredAt.Value
                                            .ToLocalTime()
                                            .ToString("MMM dd, yyyy"))
                                    </span>

                                </div>
                            }

                            <hr />

                            <div class="mb-3">

                                <p class="text-muted mb-1">
                                    Gallery
                                </p>

                                @if (!string.IsNullOrWhiteSpace(
                               Model.SessionWorkflow.GalleryUrl))
                                {
                                    <a href="@Model.SessionWorkflow.GalleryUrl"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="fw-semibold text-decoration-none">

                                        <i class="bi bi-box-arrow-up-right me-1"></i>
                                        Open Client Gallery

                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Not added yet
                                    </span>
                                }

                            </div>

                            @if (!string.IsNullOrWhiteSpace(
                           Model.SessionWorkflow.DeliveryNotes))
                            {
                                <div>

                                    <p class="text-muted mb-1">
                                        Delivery Notes
                                    </p>

                                    <p class="mb-0"
                                       style="white-space:pre-line;">
                                        @Model.SessionWorkflow.DeliveryNotes
                                    </p>

                                </div>
                            }
                        }
                        else
                        {
                            <div class="kxn-empty-state py-4">

                                <div class="kxn-empty-icon">
                                    <i class="bi bi-images"></i>
                                </div>

                                <h5 class="kxn-empty-title">
                                    Workflow not started
                                </h5>

                                <p class="kxn-empty-description">
                                    Start tracking editing and gallery delivery for this session.
                                </p>

                            </div>
                        }

                    </div>

                </div>
            }

        </div>
    </div>

</div>