@model IEnumerable<KxnPhotoStudio.Models.Invoice>

@{
    ViewData["Title"] = "Invoices";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">Invoices</h1>
            <p class="text-muted mb-0">
                Manage invoices and payments.
            </p>
        </div>

    </div>

    @if (!Model.Any())
    {
        <div class="card shadow-sm border-0">

            <div class="card-body text-center py-5">

                <i class="bi bi-receipt display-1 text-secondary"></i>

                <h3 class="mt-3">
                    No invoices found
                </h3>

                <p class="text-muted">
                    Your invoices will appear here after you create them.
                </p>

            </div>

        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th>Invoice</th>

                            <th>Client</th>

                            <th>Service</th>

                            <th>Total</th>

                            <th>Paid</th>

                            <th>Balance</th>

                            <th>Status</th>

                            <th></th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var invoice in Model)
                        {
                            <tr>

                                <td class="fw-semibold">
                                    @invoice.InvoiceNumber
                                </td>

                                <td>
                                    @invoice.Booking.FullName
                                </td>

                                <td>
                                    @invoice.Booking.ServiceType
                                </td>

                                <td>
                                    @invoice.Total.ToString("C")
                                </td>

                                <td class="text-success">
                                    @invoice.AmountPaid.ToString("C")
                                </td>

                                <td class="text-danger fw-semibold">
                                    @invoice.BalanceRemaining.ToString("C")
                                </td>

                                <td>

                                    @{
                                        var badge = invoice.Status switch
                                        {
                                            "Paid" => "bg-success",
                                            "Partially Paid" => "bg-warning text-dark",
                                            "Cancelled" => "bg-secondary",
                                            "Refunded" => "bg-info text-dark",
                                            "Draft" => "bg-secondary",
                                            _ => "bg-primary"
                                        };
                                    }

                                    <span class="badge @badge">
                                        @invoice.Status
                                    </span>

                                </td>

                                <td class="text-end">

                                    <a asp-action="Details"
                                       asp-route-id="@invoice.InvoiceId"
                                       class="btn btn-sm btn-outline-primary">

                                        <i class="bi bi-eye"></i>

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }

</div>