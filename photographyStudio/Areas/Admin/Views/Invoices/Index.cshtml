@model IEnumerable<KxnPhotoStudio.Models.Invoice>

@{
    ViewData["Title"] = "Invoices";

    var totalOutstanding = (decimal)ViewBag.TotalOutstanding;
    var paidThisMonth = (decimal)ViewBag.PaidThisMonth;
    var pendingCount = (int)ViewBag.PendingCount;
    var overdueCount = (int)ViewBag.OverdueCount;
}

<div class="container-fluid kxn-page">

    <div class="kxn-page-header">
        <div>
            <h1 class="kxn-page-title">Invoices</h1>
            <p class="kxn-page-description">
                Track invoices, payments, balances, and outstanding revenue.
            </p>
        </div>
    </div>

    <div class="kxn-card mb-4">

        <div class="kxn-card-body">

            <form asp-area="Admin"
                  asp-controller="Invoices"
                  asp-action="Index"
                  method="get">

                <div class="row g-3 align-items-end">

                    <div class="col-lg-6">

                        <label for="search"
                               class="kxn-form-label">
                            Search
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                <i class="bi bi-search"></i>
                            </span>

                            <input type="text"
                                   id="search"
                                   name="search"
                                   value="@ViewBag.Search"
                                   class="form-control"
                                   placeholder="Search invoice, client, email, or service" />

                        </div>

                    </div>

                    <div class="col-md-6 col-lg-3">

                        <label for="statusFilter"
                               class="kxn-form-label">
                            Status
                        </label>

                        <select id="statusFilter"
                                name="statusFilter"
                                class="form-select">

                            <option value="">All Invoices</option>

                            <option value="Outstanding"
                                    selected="@(ViewBag.StatusFilter == "Outstanding" ? "selected" : null)">
                                Outstanding
                            </option>

                            <option value="Paid"
                                    selected="@(ViewBag.StatusFilter == "Paid" ? "selected" : null)">
                                Paid
                            </option>

                            <option value="Pending"
                                    selected="@(ViewBag.StatusFilter == "Pending" ? "selected" : null)">
                                Pending / Partially Paid
                            </option>

                            <option value="Overdue"
                                    selected="@(ViewBag.StatusFilter == "Overdue" ? "selected" : null)">
                                Overdue
                            </option>

                            <option value="Cancelled"
                                    selected="@(ViewBag.StatusFilter == "Cancelled" ? "selected" : null)">
                                Cancelled
                            </option>

                        </select>

                    </div>

                    <div class="col-md-6 col-lg-3">

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary flex-grow-1">
                                <i class="bi bi-funnel me-1"></i>
                                Apply
                            </button>

                            <button type="button"
                                    class="btn kxn-btn-outline"
                                    onclick="window.location.replace('@Url.Action("Index", "Invoices", new { area = "Admin" })')">
                                Clear
                            </button>

                        </div>

                    </div>

                </div>

            </form>

        </div>

    </div>

    @if (!string.IsNullOrWhiteSpace(ViewBag.StatusFilter as string) ||
    !string.IsNullOrWhiteSpace(ViewBag.Search as string))
    {
        <div class="alert alert-info d-flex justify-content-between align-items-center mb-4">

            <div>

                @if (!string.IsNullOrWhiteSpace(ViewBag.Search as string) &&
               !string.IsNullOrWhiteSpace(ViewBag.StatusFilter as string))
                {
                    <span>
                        Showing results for
                        <strong>"@ViewBag.Search"</strong>
                        with filter
                        <strong>@ViewBag.StatusFilter</strong>
                    </span>
                }
                else if (!string.IsNullOrWhiteSpace(ViewBag.Search as string))
                {
                    <span>
                        Showing results for
                        <strong>"@ViewBag.Search"</strong>
                    </span>
                }
                else
                {
                    <span>
                        Showing:
                        <strong>@ViewBag.StatusFilter</strong>
                    </span>
                }

            </div>

            <button type="button"
                    class="btn btn-sm kxn-btn-outline"
                    onclick="window.location.replace('@Url.Action("Index", "Invoices", new { area = "Admin" })')">
                Clear Filters
            </button>

        </div>
    }

    <div class="row g-4 mb-4">

        <div class="col-md-6 col-xl-3">

            <partial name="_StatCard"
                     model='new KxnPhotoStudio.Models.ViewModels.StatCardViewModel
                 {
                     Label = "Outstanding Revenue",
                     Value = totalOutstanding.ToString("C"),
                     IconClass = "bi bi-cash-stack"
                 }' />

        </div>

        <div class="col-md-6 col-xl-3">

            <partial name="_StatCard"
                     model='new KxnPhotoStudio.Models.ViewModels.StatCardViewModel
                 {
                     Label = "Paid This Month",
                     Value = paidThisMonth.ToString("C"),
                     ValueClass = "text-success",
                     IconClass = "bi bi-check-circle"
                 }' />

        </div>

        <div class="col-md-6 col-xl-3">

            <partial name="_StatCard"
                     model='new KxnPhotoStudio.Models.ViewModels.StatCardViewModel
                 {
                     Label = "Pending Invoices",
                     Value = pendingCount.ToString(),
                     IconClass = "bi bi-hourglass-split"
                 }' />

        </div>

        <div class="col-md-6 col-xl-3">

            <partial name="_StatCard"
                     model='new KxnPhotoStudio.Models.ViewModels.StatCardViewModel
                 {
                     Label = "Overdue",
                     Value = overdueCount.ToString(),
                     ValueClass = "text-danger",
                     IconClass = "bi bi-exclamation-triangle"
                 }' />

        </div>

    </div>

    @if (!Model.Any())
    {
        <div class="kxn-card">

            <div class="kxn-empty-state">

                <div class="kxn-empty-icon">
                    <i class="bi bi-receipt"></i>
                </div>

                @if (!string.IsNullOrWhiteSpace(ViewBag.StatusFilter as string) ||
               !string.IsNullOrWhiteSpace(ViewBag.Search as string))
                {
                    <h4 class="kxn-empty-title">
                        No matching invoices
                    </h4>

                    <p class="kxn-empty-description">
                        Try changing your search or invoice filter.
                    </p>

                    <button type="button"
                            class="btn btn-sm kxn-btn-outline"
                            onclick="window.location.replace('@Url.Action("Index", "Invoices", new { area = "Admin" })')">
                        Clear Filters
                    </button>
                }
                else
                {
                    <h4 class="kxn-empty-title">
                        No invoices yet
                    </h4>

                    <p class="kxn-empty-description">
                        Invoices will appear here after you create them from confirmed bookings.
                    </p>
                }

            </div>

        </div>
    }
    else
    {
        <div class="kxn-table-wrapper">

            <div class="table-responsive">

                <table class="table kxn-table">

                    <thead>
                        <tr>
                            <th>Invoice</th>
                            <th>Client</th>
                            <th>Service</th>
                            <th>Event Date</th>
                            <th>Total</th>
                            <th>Paid</th>
                            <th>Balance</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var invoice in Model)
                        {
                            var isOverdue =
                            invoice.BalanceRemaining > 0 &&
                            invoice.DueDate.Date < DateTime.Today &&
                            !string.Equals(
                            invoice.Status,
                            "Cancelled",
                            StringComparison.OrdinalIgnoreCase);

                            var displayStatus = isOverdue
                            ? "Overdue"
                            : invoice.Status;

                            <tr>

                                <td>
                                    <a asp-area="Admin"
                                       asp-controller="Invoices"
                                       asp-action="Details"
                                       asp-route-id="@invoice.InvoiceId"
                                       class="fw-semibold text-decoration-none">
                                        @invoice.InvoiceNumber
                                    </a>
                                </td>

                                <td>
                                    @invoice.Booking.FullName
                                </td>

                                <td>
                                    @invoice.Booking.ServiceType
                                </td>

                                <td>
                                    @(invoice.Booking.EventDate.ToString("MMM dd, yyyy"))
                                </td>

                                <td class="fw-semibold">
                                    @invoice.Total.ToString("C")
                                </td>

                                <td class="text-success">
                                    @invoice.AmountPaid.ToString("C")
                                </td>

                                <td class="fw-semibold @(invoice.BalanceRemaining > 0 ? "text-danger" : "text-success")">
                                    @invoice.BalanceRemaining.ToString("C")
                                </td>

                                <td>
                                    <partial name="_StatusBadge"
                                             model="displayStatus" />
                                </td>

                                <td class="text-end">

                                    <a asp-area="Admin"
                                       asp-controller="Invoices"
                                       asp-action="Details"
                                       asp-route-id="@invoice.InvoiceId"
                                       class="btn btn-sm kxn-btn-outline">
                                        <i class="bi bi-eye me-1"></i>
                                        View
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }

</div>