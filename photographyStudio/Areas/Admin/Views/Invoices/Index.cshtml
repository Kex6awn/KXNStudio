@model IEnumerable<KxnPhotoStudio.Models.Invoice>

@{
    ViewData["Title"] = "Invoices";

    var totalOutstanding = Model.Sum(i => i.BalanceRemaining);

    var paidThisMonth = Model
        .Where(i => i.Status == "Paid" &&
                    i.UpdatedAt.HasValue &&
                    i.UpdatedAt.Value.Month == DateTime.UtcNow.Month &&
                    i.UpdatedAt.Value.Year == DateTime.UtcNow.Year)
        .Sum(i => i.AmountPaid);

    var pendingCount = Model.Count(i =>
        i.Status == "Pending" ||
        i.Status == "Partially Paid");

    var overdueCount = Model.Count(i =>
        i.BalanceRemaining > 0 &&
        i.DueDate.Date < DateTime.Today &&
        i.Status != "Cancelled");
}

<div class="container-fluid kxn-page">

    <div class="kxn-page-header">
        <div>
            <h1 class="kxn-page-title">Invoices</h1>
            <p class="kxn-page-description">
                Track invoices, payments, balances, and outstanding revenue.
            </p>
        </div>
    </div>

    @if (string.Equals(
    ViewBag.StatusFilter as string,
    "Outstanding",
    StringComparison.OrdinalIgnoreCase))
    {
        <div class="alert alert-info d-flex justify-content-between align-items-center mb-4">

            <div>
                Showing:
                <strong>Outstanding Invoices</strong>
            </div>

            <button type="button"
                    class="btn btn-sm kxn-btn-outline"
                    onclick="window.location.replace('@Url.Action("Index", "Invoices", new { area = "Admin" })')">
                Clear Filter
            </button>

        </div>
    }

    <div class="row g-4 mb-4">

        <div class="col-md-6 col-xl-3">

            <partial name="_StatCard"
                     model='new KxnPhotoStudio.Models.ViewModels.StatCardViewModel
                 {
                     Label = "Outstanding Revenue",
                     Value = totalOutstanding.ToString("C"),
                     IconClass = "bi bi-cash-stack"
                 }' />

        </div>

        <div class="col-md-6 col-xl-3">

            <partial name="_StatCard"
                     model='new KxnPhotoStudio.Models.ViewModels.StatCardViewModel
                 {
                     Label = "Paid This Month",
                     Value = paidThisMonth.ToString("C"),
                     ValueClass = "text-success",
                     IconClass = "bi bi-check-circle"
                 }' />

        </div>

        <div class="col-md-6 col-xl-3">

            <partial name="_StatCard"
                     model='new KxnPhotoStudio.Models.ViewModels.StatCardViewModel
                 {
                     Label = "Pending Invoices",
                     Value = pendingCount.ToString(),
                     IconClass = "bi bi-hourglass-split"
                 }' />

        </div>

        <div class="col-md-6 col-xl-3">

            <partial name="_StatCard"
                     model='new KxnPhotoStudio.Models.ViewModels.StatCardViewModel
                 {
                     Label = "Overdue",
                     Value = overdueCount.ToString(),
                     ValueClass = "text-danger",
                     IconClass = "bi bi-exclamation-triangle"
                 }' />

        </div>

    </div>

    @if (!Model.Any())
    {
        <div class="kxn-card">

            <div class="kxn-empty-state">

                <div class="kxn-empty-icon">
                    <i class="bi bi-receipt"></i>
                </div>

                @if (string.Equals(
               ViewBag.StatusFilter as string,
               "Outstanding",
               StringComparison.OrdinalIgnoreCase))
                {
                    <h4 class="kxn-empty-title">
                        No outstanding invoices
                    </h4>

                    <p class="kxn-empty-description">
                        All current invoices have been paid or there are no invoices with a remaining balance.
                    </p>

                    <button type="button"
                            class="btn kxn-btn-outline mt-3"
                            onclick="window.location.replace('@Url.Action("Index", "Invoices", new { area = "Admin" })')">
                        Clear Filter
                    </button>
                }
                else
                {
                    <h4 class="kxn-empty-title">
                        No invoices yet
                    </h4>

                    <p class="kxn-empty-description">
                        Invoices will appear here after you create them from confirmed bookings.
                    </p>
                }

            </div>

        </div>
    }
    else
    {
        <div class="kxn-table-wrapper">

            <div class="table-responsive">

                <table class="table kxn-table">

                    <thead>
                        <tr>
                            <th>Invoice</th>
                            <th>Client</th>
                            <th>Service</th>
                            <th>Event Date</th>
                            <th>Total</th>
                            <th>Paid</th>
                            <th>Balance</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var invoice in Model)
                        {
                            var isOverdue =
                            invoice.BalanceRemaining > 0 &&
                            invoice.DueDate.Date < DateTime.Today &&
                            !string.Equals(
                            invoice.Status,
                            "Cancelled",
                            StringComparison.OrdinalIgnoreCase);

                            var displayStatus = isOverdue
                            ? "Overdue"
                            : invoice.Status;

                            <tr>

                                <td>
                                    <a asp-area="Admin"
                                       asp-controller="Invoices"
                                       asp-action="Details"
                                       asp-route-id="@invoice.InvoiceId"
                                       class="fw-semibold text-decoration-none">
                                        @invoice.InvoiceNumber
                                    </a>
                                </td>

                                <td>
                                    @invoice.Booking.FullName
                                </td>

                                <td>
                                    @invoice.Booking.ServiceType
                                </td>

                                <td>
                                    @(invoice.Booking.EventDate.ToString("MMM dd, yyyy"))
                                </td>

                                <td class="fw-semibold">
                                    @invoice.Total.ToString("C")
                                </td>

                                <td class="text-success">
                                    @invoice.AmountPaid.ToString("C")
                                </td>

                                <td class="fw-semibold @(invoice.BalanceRemaining > 0 ? "text-danger" : "text-success")">
                                    @invoice.BalanceRemaining.ToString("C")
                                </td>

                                <td>
                                    <partial name="_StatusBadge"
                                             model="displayStatus" />
                                </td>

                                <td class="text-end">

                                    <a asp-area="Admin"
                                       asp-controller="Invoices"
                                       asp-action="Details"
                                       asp-route-id="@invoice.InvoiceId"
                                       class="btn btn-sm kxn-btn-outline">
                                        <i class="bi bi-eye me-1"></i>
                                        View
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }

</div>