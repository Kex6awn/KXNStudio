@model KxnPhotoStudio.Models.Invoice

@{
    ViewData["Title"] = "Invoice Details";
}

<div class="container-fluid py-4">

    <div class="d-flex gap-2">

        <a asp-area="Admin"
           asp-controller="Invoices"
           asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Invoices
        </a>

        <a asp-area="Admin"
           asp-controller="Bookings"
           asp-action="Details"
           asp-route-id="@Model.BookingId"
           class="btn btn-outline-info">
            <i class="bi bi-calendar-event me-1"></i>
            View Booking
        </a>

        @if (Model.BalanceRemaining > 0 &&
        !string.Equals(Model.Status, "Cancelled",
        StringComparison.OrdinalIgnoreCase))
        {
            <a asp-area="Admin"
               asp-controller="Invoices"
               asp-action="RecordPayment"
               asp-route-id="@Model.InvoiceId"
               class="btn btn-success">
                <i class="bi bi-cash-coin me-1"></i>
                Record Payment
            </a>
        }

    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <div class="row g-4">

        <div class="col-lg-8">

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-start mb-4">
                        <div>
                            <h3 class="fw-bold mb-1">
                                @Model.InvoiceNumber
                            </h3>

                            <p class="text-muted mb-0">
                                Issued @Model.IssueDate.ToString("MMMM dd, yyyy")
                            </p>
                        </div>

                        @{
                            var badgeClass = Model.Status switch
                            {
                                "Paid" => "bg-success",
                                "Partially Paid" => "bg-warning text-dark",
                                "Cancelled" => "bg-secondary",
                                "Refunded" => "bg-info text-dark",
                                "Draft" => "bg-secondary",
                                _ => "bg-primary"
                            };
                        }

                        <span class="badge @badgeClass px-3 py-2">
                            @Model.Status
                        </span>
                    </div>

                    <hr />

                    <div class="row g-4">

                        <div class="col-md-6">
                            <p class="text-muted mb-1">Client</p>
                            <p class="fw-semibold mb-3">
                                @Model.Booking.FullName
                            </p>

                            <p class="text-muted mb-1">Email</p>
                            <p class="mb-3">
                                @Model.Booking.Email
                            </p>

                            <p class="text-muted mb-1">Phone</p>
                            <p class="mb-0">
                                @Model.Booking.PhoneNumber
                            </p>
                        </div>

                        <div class="col-md-6">
                            <p class="text-muted mb-1">Service</p>
                            <p class="fw-semibold mb-3">
                                @Model.Booking.ServiceType
                            </p>

                            <p class="text-muted mb-1">Session Date</p>
                            <p class="mb-3">
                                @Model.Booking.EventDate.ToString("MMMM dd, yyyy")
                            </p>

                            <p class="text-muted mb-1">Due Date</p>
                            <p class="mb-0">
                                @Model.DueDate.ToString("MMMM dd, yyyy")
                            </p>
                        </div>

                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Notes))
                    {
                        <hr class="my-4" />

                        <div>
                            <p class="text-muted mb-1">Notes</p>
                            <p class="mb-0">
                                @Model.Notes
                            </p>
                        </div>
                    }

                </div>
            </div>

        </div>

        <div class="col-lg-4">

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">

                    <h4 class="fw-bold mb-4">
                        Financial Summary
                    </h4>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Subtotal</span>
                        <span>
                            @Model.Subtotal.ToString("C")
                        </span>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Tax</span>
                        <span>
                            @Model.Tax.ToString("C")
                        </span>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Discount</span>
                        <span>
                            -@Model.Discount.ToString("C")
                        </span>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between mb-3">
                        <span class="fw-bold">Total</span>
                        <span class="fw-bold fs-5">
                            @Model.Total.ToString("C")
                        </span>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Deposit Required</span>
                        <span>
                            @Model.DepositRequired.ToString("C")
                        </span>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Amount Paid</span>
                        <span class="text-success">
                            @Model.AmountPaid.ToString("C")
                        </span>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between">
                        <span class="fw-bold">Balance Remaining</span>
                        <span class="fw-bold text-danger fs-5">
                            @Model.BalanceRemaining.ToString("C")
                        </span>
                    </div>

                </div>
            </div>

        </div>

    </div>

</div>

<div class="card shadow-sm border-0 mt-4">

    <div class="card-header bg-white py-3">
        <h4 class="fw-bold mb-1">
            Payment History
        </h4>

        <p class="text-muted mb-0">
            Payments recorded for this invoice.
        </p>
    </div>

    <div class="card-body p-0">

        @if (Model.Payments.Any())
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Date</th>
                            <th>Amount</th>
                            <th>Method</th>
                            <th>Reference</th>
                            <th>Notes</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var payment in Model.Payments
                       .OrderByDescending(p => p.PaymentDate)
                       .ThenByDescending(p => p.CreatedAt))
                        {
                            <tr>

                                <td class="ps-4">
                                    @payment.PaymentDate.ToString("MMM dd, yyyy")
                                </td>

                                <td class="fw-semibold text-success">
                                    @payment.Amount.ToString("C")
                                </td>

                                <td>
                                    @payment.Method
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(payment.ReferenceNumber))
                                    {
                                        @payment.ReferenceNumber
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(payment.Notes))
                                    {
                                        @payment.Notes
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="text-center py-5">

                <i class="bi bi-cash-stack fs-1 text-muted"></i>

                <h5 class="mt-3 text-muted">
                    No payments recorded
                </h5>

                <p class="text-muted mb-0">
                    Payments will appear here after they are recorded.
                </p>

            </div>
        }

    </div>

</div>