@model KxnPhotoStudio.Models.Invoice

@{
    ViewData["Title"] = "Invoice Details";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h1 class="fw-bold mb-1">
                Invoice @Model.InvoiceNumber
            </h1>

            <p class="text-muted mb-0">
                Invoice details for @Model.Booking.FullName.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Bookings"
           asp-action="Details"
           asp-route-id="@Model.BookingId"
           class="btn btn-secondary">
            Back to Booking
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <div class="row g-4">

        <div class="col-lg-8">

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-start mb-4">
                        <div>
                            <h3 class="fw-bold mb-1">
                                @Model.InvoiceNumber
                            </h3>

                            <p class="text-muted mb-0">
                                Issued @Model.IssueDate.ToString("MMMM dd, yyyy")
                            </p>
                        </div>

                        @{
                            var badgeClass = Model.Status switch
                            {
                                "Paid" => "bg-success",
                                "Partially Paid" => "bg-warning text-dark",
                                "Cancelled" => "bg-secondary",
                                "Refunded" => "bg-info text-dark",
                                "Draft" => "bg-secondary",
                                _ => "bg-primary"
                            };
                        }

                        <span class="badge @badgeClass px-3 py-2">
                            @Model.Status
                        </span>
                    </div>

                    <hr />

                    <div class="row g-4">

                        <div class="col-md-6">
                            <p class="text-muted mb-1">Client</p>
                            <p class="fw-semibold mb-3">
                                @Model.Booking.FullName
                            </p>

                            <p class="text-muted mb-1">Email</p>
                            <p class="mb-3">
                                @Model.Booking.Email
                            </p>

                            <p class="text-muted mb-1">Phone</p>
                            <p class="mb-0">
                                @Model.Booking.PhoneNumber
                            </p>
                        </div>

                        <div class="col-md-6">
                            <p class="text-muted mb-1">Service</p>
                            <p class="fw-semibold mb-3">
                                @Model.Booking.ServiceType
                            </p>

                            <p class="text-muted mb-1">Session Date</p>
                            <p class="mb-3">
                                @Model.Booking.EventDate.ToString("MMMM dd, yyyy")
                            </p>

                            <p class="text-muted mb-1">Due Date</p>
                            <p class="mb-0">
                                @Model.DueDate.ToString("MMMM dd, yyyy")
                            </p>
                        </div>

                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Notes))
                    {
                        <hr class="my-4" />

                        <div>
                            <p class="text-muted mb-1">Notes</p>
                            <p class="mb-0">
                                @Model.Notes
                            </p>
                        </div>
                    }

                </div>
            </div>

        </div>

        <div class="col-lg-4">

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">

                    <h4 class="fw-bold mb-4">
                        Invoice Summary
                    </h4>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Subtotal</span>
                        <span>
                            @Model.Subtotal.ToString("C")
                        </span>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Tax</span>
                        <span>
                            @Model.Tax.ToString("C")
                        </span>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Discount</span>
                        <span>
                            -@Model.Discount.ToString("C")
                        </span>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between mb-3">
                        <span class="fw-bold">Total</span>
                        <span class="fw-bold fs-5">
                            @Model.Total.ToString("C")
                        </span>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Deposit Required</span>
                        <span>
                            @Model.DepositRequired.ToString("C")
                        </span>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Amount Paid</span>
                        <span class="text-success">
                            @Model.AmountPaid.ToString("C")
                        </span>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between">
                        <span class="fw-bold">Balance Remaining</span>
                        <span class="fw-bold text-danger fs-5">
                            @Model.BalanceRemaining.ToString("C")
                        </span>
                    </div>

                </div>
            </div>

        </div>

    </div>

</div>