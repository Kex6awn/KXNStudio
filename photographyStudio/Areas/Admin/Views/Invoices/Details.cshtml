@model KxnPhotoStudio.Models.Invoice
@using KxnPhotoStudio.Models.ViewModels

@{
    ViewData["Title"] = "Invoice Details";

    var pageHeader = new PageHeaderViewModel
            {
                Title = $"Invoice {Model.InvoiceNumber}",
                Description = $"Invoice details for {Model.Booking.FullName}."
            };
}

<div class="container-fluid kxn-page">

    <!-- Page Header -->
    <partial name="_PageHeader"
             model="pageHeader" />

    <!-- Actions -->
    <div class="d-flex flex-wrap justify-content-end gap-2 mb-4">

        <a asp-area="Admin"
           asp-controller="Invoices"
           asp-action="Index"
           class="btn kxn-btn-outline">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Invoices

        </a>

        <a asp-area="Admin"
           asp-controller="Bookings"
           asp-action="Details"
           asp-route-id="@Model.BookingId"
           class="btn btn-outline-info">

            <i class="bi bi-calendar-event me-1"></i>
            View Booking

        </a>

        @if (Model.BalanceRemaining > 0 &&
        !string.Equals(
        Model.Status,
        "Cancelled",
        StringComparison.OrdinalIgnoreCase))
        {
            <a asp-area="Admin"
               asp-controller="Invoices"
               asp-action="RecordPayment"
               asp-route-id="@Model.InvoiceId"
               class="btn btn-success">

                <i class="bi bi-cash-coin me-1"></i>
                Record Payment

            </a>
        }

    </div>


    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- Invoice Information + Financial Summary -->
    <div class="row g-4">

        <!-- Invoice Information -->
        <div class="col-lg-8">

            <div class="kxn-card h-100">

                <div class="kxn-card-header">

                    <div class="d-flex justify-content-between align-items-start gap-3">

                        <div>

                            <h3 class="kxn-card-title">
                                Invoice Information
                            </h3>

                            <p class="kxn-card-description">
                                Issued @Model.IssueDate.ToString("MMMM dd, yyyy")
                            </p>

                        </div>

                        <partial name="_StatusBadge"
                                 model="Model.Status" />

                    </div>

                </div>


                <div class="kxn-card-body">

                    <div class="row g-4">

                        <!-- Client Info -->
                        <div class="col-md-6">

                            <p class="text-muted mb-1">
                                Client
                            </p>

                            <p class="fw-semibold mb-4">
                                @Model.Booking.FullName
                            </p>


                            <p class="text-muted mb-1">
                                Email
                            </p>

                            <p class="mb-4">

                                <a href="mailto:@Model.Booking.Email"
                                   class="text-decoration-none">
                                    @Model.Booking.Email
                                </a>

                            </p>


                            <p class="text-muted mb-1">
                                Phone
                            </p>

                            <p class="mb-0">

                                @if (!string.IsNullOrWhiteSpace(Model.Booking.PhoneNumber))
                                {
                                    <a href="tel:@Model.Booking.PhoneNumber"
                                       class="text-decoration-none">
                                        @Model.Booking.PhoneNumber
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Not provided
                                    </span>
                                }

                            </p>

                        </div>


                        <!-- Session Info -->
                        <div class="col-md-6">

                            <p class="text-muted mb-1">
                                Service
                            </p>

                            <p class="fw-semibold mb-4">
                                @Model.Booking.ServiceType
                            </p>


                            <p class="text-muted mb-1">
                                Session Date
                            </p>

                            <p class="mb-4">
                                @Model.Booking.EventDate.ToString("MMMM dd, yyyy")
                            </p>


                            <p class="text-muted mb-1">
                                Due Date
                            </p>

                            <p class="mb-0">
                                @Model.DueDate.ToString("MMMM dd, yyyy")
                            </p>

                        </div>

                    </div>


                    @if (!string.IsNullOrWhiteSpace(Model.Notes))
                    {
                        <hr class="my-4" />

                        <div>

                            <p class="text-muted mb-1">
                                Notes
                            </p>

                            <p class="mb-0"
                               style="white-space:pre-wrap;">
                                @Model.Notes
                            </p>

                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- Financial Summary -->
        <div class="col-lg-4">

            <div class="kxn-card h-100">

                <div class="kxn-card-header">

                    <h3 class="kxn-card-title">
                        Financial Summary
                    </h3>

                    <p class="kxn-card-description">
                        Invoice totals and payment progress.
                    </p>

                </div>


                <div class="kxn-card-body">

                    <div class="d-flex justify-content-between mb-3">

                        <span class="text-muted">
                            Subtotal
                        </span>

                        <span>
                            @Model.Subtotal.ToString("C")
                        </span>

                    </div>


                    <div class="d-flex justify-content-between mb-3">

                        <span class="text-muted">
                            Tax
                        </span>

                        <span>
                            @Model.Tax.ToString("C")
                        </span>

                    </div>


                    <div class="d-flex justify-content-between mb-3">

                        <span class="text-muted">
                            Discount
                        </span>

                        <span>
                            -@Model.Discount.ToString("C")
                        </span>

                    </div>

                    <hr />


                    <div class="d-flex justify-content-between align-items-center mb-3">

                        <span class="fw-bold">
                            Total
                        </span>

                        <span class="fw-bold fs-4">
                            @Model.Total.ToString("C")
                        </span>

                    </div>


                    <div class="d-flex justify-content-between mb-3">

                        <span class="text-muted">
                            Deposit Required
                        </span>

                        <span>
                            @Model.DepositRequired.ToString("C")
                        </span>

                    </div>


                    <div class="d-flex justify-content-between mb-3">

                        <span class="text-muted">
                            Amount Paid
                        </span>

                        <span class="fw-semibold text-success">
                            @Model.AmountPaid.ToString("C")
                        </span>

                    </div>

                    <hr />


                    <div class="d-flex justify-content-between align-items-center">

                        <span class="fw-bold">
                            Balance Remaining
                        </span>

                        @if (Model.BalanceRemaining > 0)
                        {
                            <span class="fw-bold text-danger fs-4">
                                @Model.BalanceRemaining.ToString("C")
                            </span>
                        }
                        else
                        {
                            <span class="fw-bold text-success fs-4">
                                @Model.BalanceRemaining.ToString("C")
                            </span>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Payment History -->
    <div class="kxn-card mt-4">

        <div class="kxn-card-header">

            <h3 class="kxn-card-title">
                Payment History
            </h3>

            <p class="kxn-card-description">
                Payments recorded for this invoice.
            </p>

        </div>


        @if (Model.Payments.Any())
        {
            <div class="table-responsive">

                <table class="table kxn-table">

                    <thead>

                        <tr>
                            <th>Date</th>
                            <th>Amount</th>
                            <th>Method</th>
                            <th>Reference</th>
                            <th>Notes</th>
                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var payment in Model.Payments
                       .OrderByDescending(p => p.PaymentDate)
                       .ThenByDescending(p => p.CreatedAt))
                        {
                            <tr>

                                <td>
                                    @payment.PaymentDate.ToString("MMM dd, yyyy")
                                </td>

                                <td class="fw-semibold text-success">
                                    @payment.Amount.ToString("C")
                                </td>

                                <td>
                                    @payment.Method
                                </td>

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(payment.ReferenceNumber))
                                    {
                                        @payment.ReferenceNumber
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(payment.Notes))
                                    {
                                        @payment.Notes
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="kxn-empty-state">

                <div class="kxn-empty-icon">
                    <i class="bi bi-cash-stack"></i>
                </div>

                <h5 class="kxn-empty-title">
                    No payments recorded
                </h5>

                <p class="kxn-empty-description">
                    Payments will appear here after they are recorded.
                </p>

            </div>
        }

    </div>

</div>