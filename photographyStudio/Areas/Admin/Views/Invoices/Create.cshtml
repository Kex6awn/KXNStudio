@model KxnPhotoStudio.Models.ViewModels.CreateInvoiceViewModel

@{
    ViewData["Title"] = "Create Invoice";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h1 class="fw-bold mb-1">Create Invoice</h1>
            <p class="text-muted mb-0">
                Create an invoice for this confirmed booking.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Bookings"
           asp-action="Details"
           asp-route-id="@Model.BookingId"
           class="btn btn-secondary">
            Back to Booking
        </a>
    </div>

    <div class="row g-4">

        <div class="col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-4">
                        Booking Summary
                    </h4>

                    <p class="text-muted mb-1">Client</p>
                    <p class="fw-semibold">
                        @Model.ClientName
                    </p>

                    <p class="text-muted mb-1">Service</p>
                    <p class="fw-semibold">
                        @Model.ServiceType
                    </p>

                    <p class="text-muted mb-1">Event Date</p>
                    <p class="fw-semibold mb-0">
                        @Model.EventDate.ToString("MMMM dd, yyyy")
                    </p>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">

                    <form asp-area="Admin"
                          asp-controller="Invoices"
                          asp-action="Create"
                          method="post">

                        <input asp-for="BookingId"
                               type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger">
                        </div>

                        <div class="row g-3">

                            <div class="col-md-6">
                                <label asp-for="Subtotal"
                                       class="form-label">
                                </label>

                                <div class="input-group">
                                    <span class="input-group-text">$</span>

                                    <input asp-for="Subtotal"
                                           class="form-control"
                                           step="0.01"
                                           min="0" />
                                </div>

                                <span asp-validation-for="Subtotal"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Tax"
                                       class="form-label">
                                </label>

                                <div class="input-group">
                                    <span class="input-group-text">$</span>

                                    <input asp-for="Tax"
                                           class="form-control"
                                           step="0.01"
                                           min="0" />
                                </div>

                                <span asp-validation-for="Tax"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Discount"
                                       class="form-label">
                                </label>

                                <div class="input-group">
                                    <span class="input-group-text">$</span>

                                    <input asp-for="Discount"
                                           class="form-control"
                                           step="0.01"
                                           min="0" />
                                </div>

                                <span asp-validation-for="Discount"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="DepositRequired"
                                       class="form-label">
                                </label>

                                <div class="input-group">
                                    <span class="input-group-text">$</span>

                                    <input asp-for="DepositRequired"
                                           class="form-control"
                                           step="0.01"
                                           min="0" />
                                </div>

                                <span asp-validation-for="DepositRequired"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="DueDate"
                                       class="form-label">
                                </label>

                                <input asp-for="DueDate"
                                       class="form-control" />

                                <span asp-validation-for="DueDate"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Notes"
                                       class="form-label">
                                </label>

                                <textarea asp-for="Notes"
                                          class="form-control"
                                          rows="5"
                                          maxlength="2000">
                                </textarea>

                                <span asp-validation-for="Notes"
                                      class="text-danger">
                                </span>
                            </div>

                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a asp-area="Admin"
                               asp-controller="Bookings"
                               asp-action="Details"
                               asp-route-id="@Model.BookingId"
                               class="btn btn-secondary">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-success">
                                <i class="bi bi-receipt me-1"></i>
                                Create Invoice
                            </button>
                        </div>

                    </form>

                </div>
            </div>
        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}