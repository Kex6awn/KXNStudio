@model KxnPhotoStudio.Models.ViewModels.RecordPaymentViewModel
@using KxnPhotoStudio.Models.ViewModels

@{
    ViewData["Title"] = "Record Payment";

    var pageHeader = new PageHeaderViewModel
            {
                Title = "Record Payment",
                Description = $"Add a payment to invoice {Model.InvoiceNumber}."
            };
}

<div class="container-fluid kxn-page">

    <partial name="_PageHeader"
             model="pageHeader" />

    <div class="d-flex justify-content-end mb-4">

        <a asp-area="Admin"
           asp-controller="Invoices"
           asp-action="Details"
           asp-route-id="@Model.InvoiceId"
           class="btn kxn-btn-outline">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Invoice

        </a>

    </div>


    <div class="row g-4">

        <!-- Invoice Summary -->
        <div class="col-lg-4">

            <div class="kxn-card h-100">

                <div class="kxn-card-header">

                    <h3 class="kxn-card-title">
                        Invoice Summary
                    </h3>

                    <p class="kxn-card-description">
                        Current invoice totals before this payment is recorded.
                    </p>

                </div>

                <div class="kxn-card-body">

                    <div class="mb-4">

                        <p class="text-muted mb-1">
                            Invoice
                        </p>

                        <p class="fw-semibold mb-0">
                            @Model.InvoiceNumber
                        </p>

                    </div>

                    <div class="mb-4">

                        <p class="text-muted mb-1">
                            Client
                        </p>

                        <p class="fw-semibold mb-0">
                            @Model.ClientName
                        </p>

                    </div>

                    <hr />

                    <div class="d-flex justify-content-between mb-3">

                        <span class="text-muted">
                            Total
                        </span>

                        <span class="fw-semibold">
                            @Model.Total.ToString("C")
                        </span>

                    </div>

                    <div class="d-flex justify-content-between mb-3">

                        <span class="text-muted">
                            Paid
                        </span>

                        <span class="fw-semibold text-success">
                            @Model.AmountPaid.ToString("C")
                        </span>

                    </div>

                    <hr />

                    <div class="d-flex justify-content-between align-items-center">

                        <span class="fw-bold">
                            Balance
                        </span>

                        <span class="fw-bold text-danger fs-4">
                            @Model.BalanceRemaining.ToString("C")
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- Payment Form -->
        <div class="col-lg-8">

            <div class="kxn-card">

                <div class="kxn-card-header">

                    <h3 class="kxn-card-title">
                        Payment Details
                    </h3>

                    <p class="kxn-card-description">
                        Enter the payment amount, date, method, and optional reference information.
                    </p>

                </div>

                <div class="kxn-card-body">

                    <form asp-area="Admin"
                          asp-controller="Invoices"
                          asp-action="RecordPayment"
                          method="post">

                        <input asp-for="InvoiceId"
                               type="hidden" />

                        <input asp-for="InvoiceNumber"
                               type="hidden" />

                        <input asp-for="ClientName"
                               type="hidden" />

                        <input asp-for="Total"
                               type="hidden" />

                        <input asp-for="AmountPaid"
                               type="hidden" />

                        <input asp-for="BalanceRemaining"
                               type="hidden" />


                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger">
                        </div>


                        <div class="row g-4">

                            <!-- Amount -->
                            <div class="col-md-6">

                                <label asp-for="Amount"
                                       class="kxn-form-label">
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        $
                                    </span>

                                    <input asp-for="Amount"
                                           class="form-control"
                                           step="0.01"
                                           min="0.01" />

                                </div>

                                <span asp-validation-for="Amount"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Payment Date -->
                            <div class="col-md-6">

                                <label asp-for="PaymentDate"
                                       class="kxn-form-label">
                                </label>

                                <input asp-for="PaymentDate"
                                       class="form-control" />

                                <span asp-validation-for="PaymentDate"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Payment Method -->
                            <div class="col-md-6">

                                <label asp-for="Method"
                                       class="kxn-form-label">
                                </label>

                                <select asp-for="Method"
                                        class="form-select">

                                    <option value="Cash">
                                        Cash
                                    </option>

                                    <option value="Card">
                                        Card
                                    </option>

                                    <option value="Bank Transfer">
                                        Bank Transfer
                                    </option>

                                    <option value="Check">
                                        Check
                                    </option>

                                    <option value="Other">
                                        Other
                                    </option>

                                </select>

                                <span asp-validation-for="Method"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Reference Number -->
                            <div class="col-md-6">

                                <label asp-for="ReferenceNumber"
                                       class="kxn-form-label">
                                </label>

                                <input asp-for="ReferenceNumber"
                                       class="form-control"
                                       placeholder="Optional receipt or transaction ID" />

                                <span asp-validation-for="ReferenceNumber"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Notes -->
                            <div class="col-12">

                                <label asp-for="Notes"
                                       class="kxn-form-label">
                                </label>

                                <textarea asp-for="Notes"
                                          class="form-control"
                                          rows="4"
                                          maxlength="1000"
                                          placeholder="Optional payment notes"></textarea>

                                <span asp-validation-for="Notes"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>


                        <div class="kxn-form-actions">

                            <a asp-area="Admin"
                               asp-controller="Invoices"
                               asp-action="Details"
                               asp-route-id="@Model.InvoiceId"
                               class="btn kxn-btn-outline">

                                Cancel

                            </a>

                            <button type="submit"
                                    class="btn btn-success">

                                <i class="bi bi-cash-coin me-1"></i>
                                Record Payment

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}