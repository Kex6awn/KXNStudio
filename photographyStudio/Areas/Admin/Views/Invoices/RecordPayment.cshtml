@model KxnPhotoStudio.Models.ViewModels.RecordPaymentViewModel

@{
    ViewData["Title"] = "Record Payment";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h1 class="fw-bold mb-1">Record Payment</h1>
            <p class="text-muted mb-0">
                Add a payment to invoice @Model.InvoiceNumber.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Invoices"
           asp-action="Details"
           asp-route-id="@Model.InvoiceId"
           class="btn btn-secondary">
            Back to Invoice
        </a>
    </div>

    <div class="row g-4">

        <div class="col-lg-4">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">

                    <h4 class="fw-bold mb-4">
                        Invoice Summary
                    </h4>

                    <p class="text-muted mb-1">Invoice</p>
                    <p class="fw-semibold">
                        @Model.InvoiceNumber
                    </p>

                    <p class="text-muted mb-1">Client</p>
                    <p class="fw-semibold">
                        @Model.ClientName
                    </p>

                    <hr />

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Total</span>
                        <span class="fw-semibold">
                            @Model.Total.ToString("C")
                        </span>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Paid</span>
                        <span class="text-success fw-semibold">
                            @Model.AmountPaid.ToString("C")
                        </span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <span class="fw-bold">Balance</span>
                        <span class="fw-bold text-danger">
                            @Model.BalanceRemaining.ToString("C")
                        </span>
                    </div>

                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">

                    <form asp-area="Admin"
                          asp-controller="Invoices"
                          asp-action="RecordPayment"
                          method="post">

                        <input asp-for="InvoiceId"
                               type="hidden" />

                        <input asp-for="InvoiceNumber"
                               type="hidden" />

                        <input asp-for="ClientName"
                               type="hidden" />

                        <input asp-for="Total"
                               type="hidden" />

                        <input asp-for="AmountPaid"
                               type="hidden" />

                        <input asp-for="BalanceRemaining"
                               type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger">
                        </div>

                        <div class="row g-3">

                            <div class="col-md-6">
                                <label asp-for="Amount"
                                       class="form-label">
                                </label>

                                <div class="input-group">
                                    <span class="input-group-text">$</span>

                                    <input asp-for="Amount"
                                           class="form-control"
                                           step="0.01"
                                           min="0.01" />
                                </div>

                                <span asp-validation-for="Amount"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="PaymentDate"
                                       class="form-label">
                                </label>

                                <input asp-for="PaymentDate"
                                       class="form-control" />

                                <span asp-validation-for="PaymentDate"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Method"
                                       class="form-label">
                                </label>

                                <select asp-for="Method"
                                        class="form-select">

                                    <option value="Cash">Cash</option>
                                    <option value="Card">Card</option>
                                    <option value="Bank Transfer">Bank Transfer</option>
                                    <option value="Check">Check</option>
                                    <option value="Other">Other</option>

                                </select>

                                <span asp-validation-for="Method"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ReferenceNumber"
                                       class="form-label">
                                </label>

                                <input asp-for="ReferenceNumber"
                                       class="form-control"
                                       placeholder="Optional receipt or transaction ID" />

                                <span asp-validation-for="ReferenceNumber"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Notes"
                                       class="form-label">
                                </label>

                                <textarea asp-for="Notes"
                                          class="form-control"
                                          rows="4"
                                          maxlength="1000"
                                          placeholder="Optional payment notes"></textarea>

                                <span asp-validation-for="Notes"
                                      class="text-danger">
                                </span>
                            </div>

                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a asp-area="Admin"
                               asp-controller="Invoices"
                               asp-action="Details"
                               asp-route-id="@Model.InvoiceId"
                               class="btn btn-secondary">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-success">
                                <i class="bi bi-cash-coin me-1"></i>
                                Record Payment
                            </button>
                        </div>

                    </form>

                </div>
            </div>
        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}