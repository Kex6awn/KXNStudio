@model List<KxnPhotoStudio.Models.Client>
@using KxnPhotoStudio.Models.ViewModels

@{
    ViewData["Title"] = "Clients";

    var pageHeader = new PageHeaderViewModel
            {
                Title = "Clients",
                Description = "View your customers and their booking history."
            };

    var totalClients = Model.Count;

    var returningClients = Model.Count(c =>
        c.Bookings.Count > 1);

    var totalBookings = Model.Sum(c =>
        c.Bookings.Count);
}

<div class="container-fluid kxn-page">

    <partial name="_PageHeader"
             model="pageHeader" />

    <!-- Client Summary -->
    <div class="row g-4 mb-4">

        <div class="col-md-6 col-xl-4">

            <partial name="_StatCard"
                     model='new StatCardViewModel
                     {
                         Label = "Total Clients",
                         Value = totalClients.ToString(),
                         IconClass = "bi bi-people"
                     }' />

        </div>

        <div class="col-md-6 col-xl-4">

            <partial name="_StatCard"
                     model='new StatCardViewModel
                     {
                         Label = "Returning Clients",
                         Value = returningClients.ToString(),
                         ValueClass = "text-success",
                         IconClass = "bi bi-arrow-repeat"
                     }' />

        </div>

        <div class="col-md-6 col-xl-4">

            <partial name="_StatCard"
                     model='new StatCardViewModel
                     {
                         Label = "Total Client Bookings",
                         Value = totalBookings.ToString(),
                         IconClass = "bi bi-calendar-check"
                     }' />

        </div>

    </div>

    @if (Model.Any())
    {
        <div class="kxn-table-wrapper">

            <div class="table-responsive">

                <table class="table kxn-table">

                    <thead>
                        <tr>
                            <th>Client</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Bookings</th>
                            <th>Last Session</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var client in Model)
                        {
                            var lastBooking = client.Bookings
                            .OrderByDescending(b => b.EventDate)
                            .ThenByDescending(b => b.StartTime)
                            .FirstOrDefault();

                            <tr>

                                <td>

                                    <div class="fw-semibold">
                                        @client.FullName
                                    </div>

                                    <small class="text-muted">
                                        Client since
                                        @client.CreatedAt.ToString("MMM yyyy")
                                    </small>

                                </td>

                                <td>

                                    <a href="mailto:@client.Email"
                                       class="text-decoration-none">
                                        @client.Email
                                    </a>

                                </td>

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(client.PhoneNumber))
                                    {
                                        <a href="tel:@client.PhoneNumber"
                                           class="text-decoration-none">
                                            @client.PhoneNumber
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Not provided
                                        </span>
                                    }

                                </td>

                                <td>

                                    <span class="kxn-status kxn-status-pending">
                                        @client.Bookings.Count
                                    </span>

                                </td>

                                <td>

                                    @if (lastBooking != null)
                                    {
                                        @lastBooking.EventDate.ToString("MMM dd, yyyy")
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            No bookings
                                        </span>
                                    }

                                </td>

                                <td class="text-end">

                                    <a asp-area="Admin"
                                       asp-controller="Clients"
                                       asp-action="Details"
                                       asp-route-id="@client.ClientId"
                                       class="btn btn-sm kxn-btn-outline">

                                        <i class="bi bi-eye me-1"></i>
                                        View

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }
    else
    {
        <div class="kxn-card">

            <div class="kxn-empty-state">

                <div class="kxn-empty-icon">
                    <i class="bi bi-people"></i>
                </div>

                <h4 class="kxn-empty-title">
                    No clients yet
                </h4>

                <p class="kxn-empty-description">
                    Clients will appear here after they submit bookings.
                </p>

            </div>

        </div>
    }

</div>