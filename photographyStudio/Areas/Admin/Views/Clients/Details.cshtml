@model KxnPhotoStudio.Models.Client
@using KxnPhotoStudio.Models.ViewModels

@{
    ViewData["Title"] = "Client Details";

    var confirmedCount = Model.Bookings.Count(b =>
        string.Equals(
            b.Status,
            "Confirmed",
            StringComparison.OrdinalIgnoreCase));

    var pendingCount = Model.Bookings.Count(b =>
        string.Equals(
            b.Status,
            "Pending",
            StringComparison.OrdinalIgnoreCase));

    var cancelledCount = Model.Bookings.Count(b =>
        string.Equals(
            b.Status,
            "Cancelled",
            StringComparison.OrdinalIgnoreCase));

    var pageHeader = new PageHeaderViewModel
            {
                Title = Model.FullName,
                Description = "Client profile, notes, and booking history."
            };
}

<div class="container-fluid kxn-page">

    <!-- Page Header -->
    <partial name="_PageHeader"
             model="pageHeader" />

    <div class="d-flex justify-content-end mb-4">

        <a asp-area="Admin"
           asp-controller="Clients"
           asp-action="Index"
           class="btn kxn-btn-outline">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Clients

        </a>

    </div>


    <!-- Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- Client Overview -->

    <div class="row g-4 mb-4">

        <!-- Contact Information -->
        <div class="col-xl-4">

            <div class="kxn-card h-100">

                <div class="kxn-card-header">

                    <h4 class="kxn-card-title">
                        Contact Information
                    </h4>

                    <p class="kxn-card-description">
                        Primary contact details for this client.
                    </p>

                </div>

                <div class="kxn-card-body">

                    <div class="mb-4">

                        <p class="text-muted mb-1">
                            Email
                        </p>

                        <a href="mailto:@Model.Email"
                           class="fw-semibold text-decoration-none">
                            @Model.Email
                        </a>

                    </div>

                    <div class="mb-4">

                        <p class="text-muted mb-1">
                            Phone
                        </p>

                        @if (!string.IsNullOrWhiteSpace(Model.PhoneNumber))
                        {
                            <a href="tel:@Model.PhoneNumber"
                               class="fw-semibold text-decoration-none">
                                @Model.PhoneNumber
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">
                                Not provided
                            </span>
                        }

                    </div>

                    <div>

                        <p class="text-muted mb-1">
                            Client Since
                        </p>

                        <p class="fw-semibold mb-0">
                            @Model.CreatedAt.ToString("MMMM dd, yyyy")
                        </p>

                    </div>

                </div>

            </div>

        </div>


        <!-- Client Statistics -->
        <div class="col-xl-8">

            <div class="row g-3">

                <div class="col-sm-6 col-xl-3">

                    <partial name="_StatCard"
                             model='new StatCardViewModel
                             {
                                 Label = "Total Bookings",
                                 Value = Model.Bookings.Count.ToString(),
                                 IconClass = "bi bi-calendar-check"
                             }' />

                </div>

                <div class="col-sm-6 col-xl-3">

                    <partial name="_StatCard"
                             model='new StatCardViewModel
                             {
                                 Label = "Confirmed",
                                 Value = confirmedCount.ToString(),
                                 ValueClass = "text-success",
                                 IconClass = "bi bi-check-circle"
                             }' />

                </div>

                <div class="col-sm-6 col-xl-3">

                    <partial name="_StatCard"
                             model='new StatCardViewModel
                             {
                                 Label = "Pending",
                                 Value = pendingCount.ToString(),
                                 IconClass = "bi bi-hourglass-split"
                             }' />

                </div>

                <div class="col-sm-6 col-xl-3">

                    <partial name="_StatCard"
                             model='new StatCardViewModel
                             {
                                 Label = "Cancelled",
                                 Value = cancelledCount.ToString(),
                                 ValueClass = "text-secondary",
                                 IconClass = "bi bi-slash-circle"
                             }' />

                </div>

            </div>

        </div>

    </div>


    <!-- Client Notes -->

    <div class="kxn-card mt-4 client-notes-card">

        <div class="kxn-card-header d-flex justify-content-between align-items-center">

            <div>

                <h4 class="kxn-card-title">

                    <i class="bi bi-journal-text me-2"></i>
                    Client Notes

                </h4>

                <p class="kxn-card-description">
                    Preferences, reminders, and important client details.
                </p>

            </div>

            <button type="button"
                    class="btn btn-success"
                    data-bs-toggle="modal"
                    data-bs-target="#addNoteModal">

                <i class="bi bi-plus-circle me-1"></i>
                Add Note

            </button>

        </div>


        <div class="kxn-card-body">

            @if (Model.Notes.Any())
            {
                <div class="notes-timeline">

                    @foreach (var note in Model.Notes)
                    {
                        <div class="note-item">

                            <div class="note-marker">

                                <i class="bi bi-sticky"></i>

                            </div>


                            <div class="note-content">

                                <div class="note-meta">

                                    <div class="d-flex align-items-center gap-2">

                                        <i class="bi bi-clock text-secondary"></i>

                                        <span class="fw-semibold">

                                            @(note.CreatedAt
                                                .ToLocalTime()
                                                .ToString(
                                                "MMM dd, yyyy 'at' h:mm tt"))

                                        </span>

                                    </div>

                                    @if (note.UpdatedAt.HasValue)
                                    {
                                        <small class="text-muted d-block mt-1">

                                            Last edited:

                                            @(note.UpdatedAt.Value
                                                .ToLocalTime()
                                                .ToString(
                                                "MMM dd, yyyy 'at' h:mm tt"))

                                        </small>
                                    }

                                </div>


                                <div class="note-body">
                                    @note.Content
                                </div>


                                <div class="note-actions">

                                    <button type="button"
                                            class="btn btn-sm btn-primary"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editNoteModal-@note.ClientNoteId">

                                        <i class="bi bi-pencil me-1"></i>
                                        Edit

                                    </button>

                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deleteNoteModal-@note.ClientNoteId">

                                        <i class="bi bi-trash me-1"></i>
                                        Delete

                                    </button>

                                </div>

                            </div>

                        </div>


                        <!-- Edit Note Modal -->

                        <div class="modal fade"
                             id="editNoteModal-@note.ClientNoteId"
                             tabindex="-1"
                             aria-hidden="true">

                            <div class="modal-dialog modal-dialog-centered">

                                <div class="modal-content">

                                    <form asp-area="Admin"
                                          asp-controller="ClientNotes"
                                          asp-action="Edit"
                                          method="post">

                                        <div class="modal-header">

                                            <h5 class="modal-title">
                                                Edit Client Note
                                            </h5>

                                            <button type="button"
                                                    class="btn-close"
                                                    data-bs-dismiss="modal">
                                            </button>

                                        </div>


                                        <div class="modal-body">

                                            <input type="hidden"
                                                   name="clientNoteId"
                                                   value="@note.ClientNoteId" />

                                            <label class="form-label"
                                                   for="editContent-@note.ClientNoteId">
                                                Note
                                            </label>

                                            <textarea id="editContent-@note.ClientNoteId"
                                                      name="content"
                                                      class="form-control"
                                                      rows="6"
                                                      maxlength="2000"
                                                      required>@note.Content</textarea>

                                        </div>


                                        <div class="modal-footer">

                                            <button type="button"
                                                    class="btn btn-secondary"
                                                    data-bs-dismiss="modal">
                                                Cancel
                                            </button>

                                            <button type="submit"
                                                    class="btn btn-success">
                                                Save Changes
                                            </button>

                                        </div>

                                    </form>

                                </div>

                            </div>

                        </div>


                        <!-- Delete Note Modal -->

                        <div class="modal fade"
                             id="deleteNoteModal-@note.ClientNoteId"
                             tabindex="-1"
                             aria-hidden="true">

                            <div class="modal-dialog modal-dialog-centered">

                                <div class="modal-content">

                                    <form asp-area="Admin"
                                          asp-controller="ClientNotes"
                                          asp-action="Delete"
                                          method="post">

                                        <div class="modal-header">

                                            <h5 class="modal-title">
                                                Delete Client Note
                                            </h5>

                                            <button type="button"
                                                    class="btn-close"
                                                    data-bs-dismiss="modal">
                                            </button>

                                        </div>


                                        <div class="modal-body">

                                            <input type="hidden"
                                                   name="clientNoteId"
                                                   value="@note.ClientNoteId" />

                                            <p>
                                                Are you sure you want to permanently
                                                delete this note?
                                            </p>

                                            <div class="alert alert-light border mb-0">
                                                @note.Content
                                            </div>

                                        </div>


                                        <div class="modal-footer">

                                            <button type="button"
                                                    class="btn btn-secondary"
                                                    data-bs-dismiss="modal">
                                                Cancel
                                            </button>

                                            <button type="submit"
                                                    class="btn btn-danger">
                                                Delete Note
                                            </button>

                                        </div>

                                    </form>

                                </div>

                            </div>

                        </div>
                    }

                </div>
            }
            else
            {
                <div class="kxn-empty-state">

                    <div class="kxn-empty-icon">
                        <i class="bi bi-journal-x"></i>
                    </div>

                    <h5 class="kxn-empty-title">
                        No client notes yet
                    </h5>

                    <p class="kxn-empty-description">
                        Add preferences, reminders, or session details here.
                    </p>

                </div>
            }

        </div>

    </div>


    <!-- Booking History -->

    <div class="kxn-card mt-4">

        <div class="kxn-card-header">

            <h4 class="kxn-card-title">
                Booking History
            </h4>

            <p class="kxn-card-description">
                All bookings connected to this client.
            </p>

        </div>


        @if (Model.Bookings.Any())
        {
            <div class="table-responsive">

                <table class="table kxn-table">

                    <thead>

                        <tr>
                            <th>Service</th>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Duration</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var booking in Model.Bookings)
                        {
                            var formattedTime = DateTime.Today
                            .Add(booking.StartTime)
                            .ToString("h:mm tt");

                            <tr>

                                <td class="fw-semibold">
                                    @booking.ServiceType
                                </td>

                                <td>
                                    @booking.EventDate.ToString("MMM dd, yyyy")
                                </td>

                                <td>
                                    @formattedTime
                                </td>

                                <td>
                                    @booking.DurationHours hour(s)
                                </td>

                                <td>

                                    <partial name="_StatusBadge"
                                             model="booking.Status" />

                                </td>

                                <td class="text-end">

                                    <div class="d-inline-flex gap-2">

                                        <a asp-area="Admin"
                                           asp-controller="Bookings"
                                           asp-action="Details"
                                           asp-route-id="@booking.BookingId"
                                           class="btn btn-sm kxn-btn-outline">

                                            <i class="bi bi-eye me-1"></i>
                                            View

                                        </a>

                                        <a asp-area="Admin"
                                           asp-controller="Bookings"
                                           asp-action="Edit"
                                           asp-route-id="@booking.BookingId"
                                           class="btn btn-sm btn-primary">

                                            <i class="bi bi-pencil me-1"></i>
                                            Edit

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="kxn-empty-state">

                <div class="kxn-empty-icon">
                    <i class="bi bi-calendar-x"></i>
                </div>

                <h5 class="kxn-empty-title">
                    No booking history
                </h5>

                <p class="kxn-empty-description">
                    This client does not have any bookings yet.
                </p>

            </div>
        }

    </div>


    <!-- Add Note Modal -->

    <div class="modal fade"
         id="addNoteModal"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <form asp-area="Admin"
                      asp-controller="ClientNotes"
                      asp-action="Create"
                      method="post">

                    <div class="modal-header">

                        <h5 class="modal-title">
                            Add Client Note
                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal">
                        </button>

                    </div>


                    <div class="modal-body">

                        <input type="hidden"
                               name="clientId"
                               value="@Model.ClientId" />

                        <label for="newNoteContent"
                               class="form-label">
                            Note
                        </label>

                        <textarea id="newNoteContent"
                                  name="content"
                                  class="form-control"
                                  rows="6"
                                  maxlength="2000"
                                  placeholder="Enter client preferences, reminders, or session details..."
                                  required></textarea>

                        <div class="form-text">
                            Maximum 2,000 characters.
                        </div>

                    </div>


                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button type="submit"
                                class="btn btn-success">
                            Save Note
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


@section Styles
{
    <style>

        .client-notes-card {
            border-radius: 16px;
        }

        .notes-timeline {
            position: relative;
        }

        .note-item {
            position: relative;
            display: flex;
            align-items: flex-start;
            gap: 18px;
            padding-bottom: 28px;
        }

            .note-item:not(:last-child)::before {
                content: "";
                position: absolute;
                top: 42px;
                bottom: 0;
                left: 20px;
                width: 2px;
                background-color: #dee2e6;
            }

        .note-marker {
            position: relative;
            z-index: 1;
            width: 42px;
            height: 42px;
            flex: 0 0 42px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 4px solid #ffffff;
            border-radius: 50%;
            background-color: #212529;
            color: #ffffff;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.18);
        }

        .note-content {
            width: 100%;
            min-width: 0;
            padding: 20px;
            border: 1px solid #e5e7eb;
            border-left: 4px solid #212529;
            border-radius: 14px;
            background-color: #ffffff;
            text-align: left;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

            .note-content:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(0, 0, 0, 0.07);
            }

        .note-meta {
            text-align: left;
        }

        .note-body {
            width: 100%;
            margin-top: 18px;
            color: #495057;
            font-size: 15px;
            line-height: 1.7;
            text-align: left !important;
            white-space: pre-line;
            overflow-wrap: anywhere;
        }

        .note-actions {
            display: flex;
            justify-content: flex-end;
            gap: 8px;
            margin-top: 20px;
            padding-top: 15px;
            border-top: 1px solid #eeeeee;
        }


        @@media (max-width: 575.98px) {

            .client-notes-card .kxn-card-header {
                flex-direction: column;
                align-items: stretch !important;
                gap: 15px;
            }

                .client-notes-card .kxn-card-header .btn {
                    width: 100%;
                }

            .client-notes-card .kxn-card-body {
                padding: 16px !important;
            }

            .note-item {
                gap: 10px;
            }

            .note-marker {
                width: 34px;
                height: 34px;
                flex-basis: 34px;
                border-width: 3px;
                font-size: 0.8rem;
            }

            .note-item:not(:last-child)::before {
                top: 34px;
                left: 16px;
            }

            .note-content {
                padding: 15px;
            }

            .note-meta .fw-semibold {
                font-size: 0.82rem;
            }

            .note-meta small {
                font-size: 0.75rem;
            }

            .note-actions {
                justify-content: flex-start;
                flex-wrap: wrap;
            }
        }

    </style>
}