@model List<KxnPhotoStudio.Models.Photo>

@{
    ViewData["Title"] = "Portfolio";
    var categories = ViewBag.Categories as List<KxnPhotoStudio.Models.Category>;
    int? selectedCategoryId = ViewBag.SelectedCategoryId as int?;
}

<h1 class="text-center mt-4">Our Work</h1>

<div class="container mt-4">

    <div class="mb-4 text-center">
        <a asp-controller="Portfolio" asp-action="Index"
           class="btn @(selectedCategoryId == null ? "btn-dark" : "btn-outline-dark") me-2 mb-2">
            All
        </a>

        @if (categories != null)
        {
            @foreach (var category in categories)
            {
                <a asp-controller="Portfolio"
                   asp-action="Index"
                   asp-route-categoryId="@category.CategoryId"
                   class="btn @(selectedCategoryId == category.CategoryId ? "btn-dark" : "btn-outline-dark") me-2 mb-2">
                    @category.Name
                </a>
            }
        }
    </div>

    <div class="row">
        @if (!Model.Any())
        {
            <p class="text-center">No photos uploaded yet.</p>
        }
        else
        {
            @foreach (var photo in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card shadow-sm h-100">
                        <img src="@photo.ImagePath"
                             class="card-img-top portfolio-img"
                             alt="@photo.Title"
                             loading="lazy"
                             data-title="@photo.Title"
                             data-description="@photo.Description" />
                        <div class="card-body">
                            <h5>@photo.Title</h5>
                            <p class="text-muted mb-0">@photo.Category?.Name</p>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<div class="modal fade" id="lightboxModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content bg-black text-white border-0">
            <div class="modal-header border-0">
                <div>
                    <h5 class="modal-title" id="lightboxTitle"></h5>
                    <small id="lightboxCounter" class="text-muted"></small>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body text-center position-relative">
                <button type="button"
                        class="btn btn-light position-absolute top-50 start-0 translate-middle-y ms-3"
                        id="prevBtn">
                    ←
                </button>

                <img id="lightboxImage" src="" alt="" class="img-fluid rounded" style="max-height: 75vh;" />

                <button type="button"
                        class="btn btn-light position-absolute top-50 end-0 translate-middle-y me-3"
                        id="nextBtn">
                    →
                </button>

                <p id="lightboxDescription" class="mt-3 mb-0"></p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const lightboxCounter = document.getElementById("lightboxCounter");
        const galleryImages = Array.from(document.querySelectorAll(".portfolio-img"));
        const lightboxElement = document.getElementById("lightboxModal");
        const lightboxModal = new bootstrap.Modal(lightboxElement);
        const lightboxImage = document.getElementById("lightboxImage");
        const lightboxTitle = document.getElementById("lightboxTitle");
        const lightboxDescription = document.getElementById("lightboxDescription");
        const prevBtn = document.getElementById("prevBtn");
        const nextBtn = document.getElementById("nextBtn");

        let currentIndex = 0;

        function showImage(index) {

            if (galleryImages.length === 0) return;

            if (index < 0) {
                currentIndex = galleryImages.length - 1;
            } else if (index >= galleryImages.length) {
                currentIndex = 0;
            } else {
                currentIndex = index;
            }

            if (galleryImages.length <= 1) {
                prevBtn.style.display = "none";
                nextBtn.style.display = "none";
            } else  {
                prevBtn.style.display = "block";
                nextBtn.style.display = "block";
            }

            const img = galleryImages[currentIndex];
            lightboxCounter.textContent = (currentIndex + 1) + " / " + galleryImages.length;
            lightboxImage.src = img.src;
            lightboxImage.alt = img.alt || "";
            lightboxTitle.textContent = img.dataset.title || "";
            lightboxDescription.textContent = img.dataset.description || "";
        }

        galleryImages.forEach((img, index) => {
            img.style.cursor = "pointer";

            img.addEventListener("click", function () {
                showImage(index);
                lightboxModal.show();
            });
        });

        prevBtn.addEventListener("click", function () {
            showImage(currentIndex - 1);
        });

        nextBtn.addEventListener("click", function () {
            showImage(currentIndex + 1);
        });

        document.addEventListener("keydown", function (e) {
            const modalIsOpen = lightboxElement.classList.contains("show");

            if (!modalIsOpen) return;

            if (e.key === "ArrowLeft") {
                showImage(currentIndex - 1);
            } else if (e.key === "ArrowRight") {
                showImage(currentIndex + 1);
            } else if (e.key === "Escape") {
                lightboxModal.hide();
            }
        });

        let touchStartX = 0;
        let touchEndX = 0;

        lightboxImage.addEventListener("touchstart", e => {
            touchStartX = e.changedTOuches[0].screenX;
        });

        lightboxImage.addEventListener("touchend", e => {
            touchEndX = e.changedTouches[0].screenX;
            handleGesture();
        });

        function handleSwipe() {
            if (touchEndX < touchStartX - 50) {
                showImage(currentIndex + 1); // swipe left > next
            } else if (touchEndX > touchStartX + 50) {
                showImage(currentIndex - 1); // swipe right > previous
            }
        }
    </script>
}